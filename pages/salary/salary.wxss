.page {
  padding-bottom: 160rpx;
}

/* 发薪倒计时卡片（与全局卡片流统一，浅色/深色自动适配） */
.salary-count {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sc-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.sc-sub {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

.sc-days {
  display: flex;
  align-items: baseline;
}

.sc-num {
  color: var(--gold);
  font-size: 88rpx;
  font-weight: 800;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  letter-spacing: -0.02em;
}

.sc-unit {
  color: var(--text-sub);
  font-size: 28rpx;
  margin-left: 8rpx;
}

/* 年度累计 */
.year-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.year-label {
  font-size: 28rpx;
  color: var(--text-sub);
}

.year-num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--gold);
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}

/* 记录列表 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.row:last-child {
  border-bottom: none;
}

.row-date {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 收入来源标签:主业金 / 副业蓝 / 年终奖红 / 红包橙 / 理财绿 / 其他灰 */
.source-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.6;
}
.source-tag.main {
  background: rgba(200, 160, 77, 0.12);
  color: var(--gold-700, #8a6d2b);
  border: 1rpx solid rgba(200, 160, 77, 0.35);
}
.source-tag.side {
  background: rgba(72, 128, 200, 0.12);
  color: #2c5fa3;
  border: 1rpx solid rgba(72, 128, 200, 0.35);
}
.source-tag.bonus {
  background: var(--danger-bg);
  color: var(--danger);
  border: 1rpx solid var(--danger-border);
}
.source-tag.gift {
  background: var(--warn-bg);
  color: var(--warn);
  border: 1rpx solid var(--warn-border);
}
.source-tag.invest {
  background: var(--success-bg);
  color: var(--success);
  border: 1rpx solid rgba(47, 155, 107, 0.35);
}
.source-tag.other {
  background: var(--chip-bg);
  color: var(--text-sub);
  border: 1rpx solid var(--border);
}

/* 收入类型选择器已抽为公共组件 components/cat-grid（图标网格版），样式随组件走 */

.row-note {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.row-right {
  display: flex;
  align-items: center;
}

.row-amount {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--gold);
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}

.row-del {
  font-size: 24rpx;
  color: var(--danger);
  margin-left: 24rpx;
  padding: 8rpx;
}

/* 悬浮添加按钮样式见 app.wxss 全局 .fab */
