.lock-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.lock-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--navy-700, #14304F);
  margin-bottom: 12rpx;
}

.lock-sub {
  font-size: 26rpx;
  color: var(--text-sub, #97A3B2);
  margin-bottom: 60rpx;
}

.gesture-wrap {
  width: 560rpx;
  height: 560rpx;
}

.gesture-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.lock-links {
  margin-top: 60rpx;
  display: flex;
  gap: 48rpx;
}

.lock-link {
  font-size: 26rpx;
  color: var(--text-sub, #97A3B2);
  padding: 12rpx 24rpx;
}

.finger-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 60rpx 80rpx;
  border-radius: 24rpx;
  background: var(--card, #fff);
  box-shadow: 0 8rpx 24rpx var(--shadow-card);
}

.finger-btn:active {
  transform: scale(0.97);
}

.finger-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--navy-700, #14304F), var(--navy-900, #0E2238));
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.finger-text {
  font-size: 26rpx;
  color: var(--text-sub, #97A3B2);
}
