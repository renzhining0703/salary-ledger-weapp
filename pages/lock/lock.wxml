<view class="page lock-page {{themeClass}}">
  <!-- 手势锁 -->
  <block wx:if="{{lockType === 'gesture'}}">
    <view class="lock-title">{{mode === 'set' ? setStepTitle : '绘制解锁图案'}}</view>
    <view class="lock-sub">{{mode === 'set' ? '连接至少 4 个点' : '请绘制您的解锁图案'}}</view>

    <view class="gesture-wrap">
      <canvas
        type="2d"
        id="gestureCanvas"
        class="gesture-canvas"
        catchtouchstart="onTouchStart"
        catchtouchmove="onTouchMove"
        catchtouchend="onTouchEnd"
      ></canvas>
    </view>

    <view class="lock-links" wx:if="{{mode === 'set'}}">
      <view class="lock-link" bindtap="resetSet">重新绘制</view>
    </view>
    <view class="lock-links" wx:else>
      <view class="lock-link" bindtap="quitLock">退出小程序</view>
    </view>
  </block>

  <!-- 指纹锁 -->
  <block wx:if="{{lockType === 'finger'}}">
    <view class="lock-title">指纹解锁</view>
    <view class="lock-sub">{{fingerTip}}</view>
    <view class="finger-btn" bindtap="startFingerAuth">
      <view class="finger-icon">◉</view>
      <view class="finger-text">点击进行指纹验证</view>
    </view>
    <view class="lock-links">
      <view class="lock-link" bindtap="quitLock">退出小程序</view>
    </view>
  </block>

  <!-- 无锁兜底 -->
  <block wx:if="{{lockType === 'none'}}">
    <view class="lock-title">未启用隐私锁</view>
    <view class="lock-sub">正在进入…</view>
  </block>
</view>
