/* 我的页 —— 卡片流风格，浅色/深色跟随系统主题 */

.page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ---------- 用户资料卡（普通卡片，与全局卡片流统一） ---------- */
.my-hero {
  background: var(--card);
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  margin: 24rpx;
  box-shadow: 0 8rpx 28rpx var(--shadow-card);
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.my-avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.my-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  box-sizing: border-box;
}

/* 未设头像：实心深蓝渐变圆 + 金色人形剪影（无边框，避免 iOS 描边变形） */
.my-avatar.placeholder {
  background: linear-gradient(135deg, var(--navy-600), var(--navy-800));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.my-avatar.placeholder .ph-head {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--gold);
}

.my-avatar.placeholder .ph-body {
  width: 62rpx;
  height: 30rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: var(--gold);
  margin-top: 8rpx;
}

/* 编辑角标：金色圆 + 铅笔 */
.my-avatar-edit {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--gold);
  color: var(--navy-900);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.25);
  border: 3rpx solid var(--card);
  box-sizing: border-box;
}

.my-user-meta {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.my-nick-display {
  color: var(--text);
  font-size: 36rpx;
  font-weight: 700;
  height: 60rpx;
  line-height: 60rpx;
}

/* 未设置昵称时显示"点此设置昵称"占位符，弱化样式与有昵称区分 */
.my-nick-display.is-empty {
  color: var(--text-mute);
  font-weight: 400;
}

.my-user-motto {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.motto-text {
  font-size: 23rpx;
  color: var(--text-sub);
}

.motto-edit-icon {
  font-size: 22rpx;
  color: var(--gold);
  opacity: 0.8;
}

.motto-input {
  font-size: 32rpx;
  font-weight: 500;
}

/* ---------- 分组卡片 ---------- */
.my-group {
  margin-bottom: 24rpx;
}

.my-group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.my-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  position: relative;
}

.my-row:last-of-type {
  border-bottom: none;
}

picker .my-row {
  padding-right: 8rpx;
}

.my-row-main {
  flex: 1;
  min-width: 0;
}

.my-row-label {
  font-size: 29rpx;
  color: var(--text);
  font-weight: 500;
}

.my-row-label.danger {
  color: var(--danger);
}

.my-row-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-sub);
}

.my-row-val {
  font-size: 27rpx;
  color: var(--gold-700, #A98436);
  font-weight: 500;
  margin-left: 16rpx;
}

.my-row-input {
  text-align: right;
  font-size: 27rpx;
  color: var(--text);
  font-weight: 500;
  margin-left: 16rpx;
  width: 220rpx;
}

.my-row-arrow {
  margin-left: 10rpx;
  font-size: 32rpx;
  color: var(--text-mute);
  line-height: 1;
}

.my-switch {
  transform: scale(0.85);
  margin-left: 12rpx;
}

/* 行点击反馈（tap 行为在 picker / bindtap 上） */
.my-row-danger {
  border-radius: 16rpx;
}

.my-save-btn {
  margin-top: 28rpx;
}

.my-footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-mute);
  padding: 32rpx 0 8rpx;
}

/* ---------- 编辑资料半屏弹层 ---------- */
/* sheet / mask / sheet-title / sheet-actions / sheet 动画：来自 app.wxss 全局样式 */

.edit-avatar-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto 8rpx;
}

.edit-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  box-sizing: border-box;
}

/* 弹层内未设头像：与顶部 placeholder 风格一致 */
.edit-avatar.placeholder {
  background: linear-gradient(135deg, var(--navy-600), var(--navy-800));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.edit-avatar.placeholder .ph-head {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: var(--gold);
}
.edit-avatar.placeholder .ph-body {
  width: 88rpx;
  height: 42rpx;
  border-radius: 42rpx 42rpx 0 0;
  background: var(--gold);
  margin-top: 12rpx;
}

/* 透明 button 覆盖在大头像上触发微信 chooseAvatar */
.edit-avatar-hit {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  z-index: 2;
}
.edit-avatar-hit::after {
  border: none;
}

.edit-avatar-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-mute);
  margin-bottom: 24rpx;
}

.edit-nick-item {
  margin-top: 16rpx;
}
.edit-nick-input {
  /* 复用 .form-input 风格，此处仅微调：略大字号与昵称匹配 */
  font-size: 32rpx;
  font-weight: 500;
}

.edit-save-btn {
  margin-top: 8rpx;
}

.edit-cancel {
  text-align: center;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 16rpx 0;
}

/* ---------- 分类预算：列表 sheet + 编辑 sheet ---------- */
/* 列表提示条 */
.cat-budgets-hint {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--input-bg);
  border-radius: 12rpx;
}
/* 分类行：名称+本月已花 | 预算 chip | 箭头 */
.cat-budget-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid var(--border);
}
.cat-budget-row:last-child {
  border-bottom: none;
}
.cat-budget-row-hover {
  opacity: 0.7;
}
.cat-budget-row-main {
  flex: 1;
  min-width: 0;
}
.cat-budget-row-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.cat-budget-row-spent {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}
/* 预算 chip：未设虚线引导 / 已设金色 / 超支红色（与账单 sheet 视觉一致） */
.cat-budget-chip {
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  white-space: nowrap;
  font-family: "DIN Alternate", sans-serif;
}
.cat-budget-chip.unset {
  border: 1rpx dashed var(--border);
  color: var(--text-mute);
  background: transparent;
}
.cat-budget-chip.set {
  background: rgba(200, 160, 77, 0.15);
  color: var(--gold);
}
.cat-budget-chip.set.over {
  background: var(--danger-bg);
  color: var(--danger);
}
/* 编辑 sheet：本月已花提示条 + 大号金额输入 */
.cat-budget-hint {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  background: var(--input-bg);
  border-radius: 12rpx;
}
.my-amount-input {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--navy-700);
}
.cat-budget-clear-btn {
  margin-bottom: 12rpx;
  background: var(--input-bg);
  color: var(--text-sub);
}

/* ---------- 固定支出（从记账页移入） ---------- */
/* 管理弹层 */
.recur-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  gap: 16rpx;
}

.recur-row.inactive .recur-name,
.recur-row.inactive .recur-meta,
.recur-row.inactive .recur-amount {
  color: var(--text-mute);
}

.recur-info {
  flex: 1;
  min-width: 0;
}

.recur-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.recur-meta {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.recur-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.recur-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--navy-700);
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}

.recur-del {
  font-size: 24rpx;
  color: var(--danger);
  padding: 8rpx 4rpx;
}

.recur-tip {
  font-size: 24rpx;
  color: var(--text-sub);
  margin: -8rpx 0 16rpx;
}

.recur-record {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--gold);
  border: 2rpx solid var(--gold);
  border-radius: 999rpx;
  background: var(--tint-gold-06);
  white-space: nowrap;
}

.recur-record:active {
  background: var(--tint-gold-18);
}

.recur-record.done {
  color: var(--text-mute);
  border-color: var(--border);
  background: var(--input-bg);
}

.recur-done-text {
  color: var(--gold);
}

.recur-auto {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.recur-auto-label {
  font-size: 22rpx;
  color: var(--text-sub);
}

.recur-auto switch {
  transform: scale(0.85);
  transform-origin: right center;
}

/* ---------- 分类选择 chips（固定支出表单用） ---------- */
.cat-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  min-width: 120rpx;
  text-align: center;
  padding: 16rpx 28rpx;
  background: var(--chip-bg);
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  transition: all 0.1s ease;
}

.chip-active {
  background: linear-gradient(135deg, var(--navy-700), var(--navy-800));
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx var(--shadow-strong);
}
