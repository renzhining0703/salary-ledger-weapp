<view class="page" bindtap="onPageTap">
  <!-- 顶部用户栏 -->
  <view class="header">
    <view class="user" bindtap="openProfile">
      <image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar placeholder">薪</view>
      <view class="user-meta">
        <view class="nick">{{user.nickname || '未设置昵称'}}</view>
        <view class="sub">每月{{user.payday || 15}}号发薪 · 月预算 ¥{{user.budget || 4000}}</view>
      </view>
    </view>
    <view class="remind-btn" bindtap="subscribeRemind">还款提醒</view>
  </view>

  <!-- 今天要处理（置顶；无事项时整张卡隐藏，避免噪音） -->
  <view wx:if="{{todoList.length}}" class="card">
    <view class="card-title">今天要处理</view>
    <view wx:for="{{todoList}}" wx:key="id" class="todo-item {{item.level}}">
      <view class="todo-main">
        <view class="todo-top">
          <text class="todo-bank">{{item.bank}}</text>
          <view class="tag tag-red" wx:if="{{item.level === 'overdue'}}">逾期</view>
          <view class="tag tag-red" wx:elif="{{item.level === 'today'}}">今天</view>
          <view class="tag tag-yellow" wx:else>明天</view>
        </view>
        <view class="todo-amount">¥{{item.amount}}</view>
        <view class="todo-due">{{item.dueText}}</view>
      </view>
      <view class="btn btn-sm btn-primary pay-btn" bindtap="markPaid" data-id="{{item.id}}" wx:if="{{item.canPay}}">标记已还</view>
    </view>
  </view>

  <!-- 最优还款顺序（多卡用户专属；≥3 张未还时才显示，避免给少卡用户增加噪音） -->
  <view wx:if="{{optimalPreview && optimalPreview.pendingCount >= 3}}" class="card opt-card" bindtap="openOptimalSheet">
    <view class="opt-head">
      <view class="opt-titles">
        <view class="card-title">最优还款顺序</view>
        <view class="opt-sub">{{optimalPreview.subText}}</view>
      </view>
      <view class="opt-arrow">›</view>
    </view>
    <view class="opt-preview-row">
      <view class="opt-prev-rank">1</view>
      <view class="opt-prev-info">
        <view class="opt-prev-bank">{{optimalPreview.first.bank}}</view>
        <view class="opt-prev-amount">¥{{optimalPreview.first.amountText}}</view>
      </view>
      <view class="opt-prev-due">{{optimalPreview.first.dueText}}</view>
    </view>
  </view>

  <!-- 预算超支预警 -->
  <view wx:if="{{budgetAlert}}" class="card budget-alert {{budgetAlert.type}}">
    <view class="ba-dot"></view>
    <view class="ba-text">{{budgetAlert.text}}</view>
  </view>

  <!-- 月度结余看板 -->
  <view class="card">
    <view class="board-head">
      <view class="board-arrow" bindtap="prevMonth">‹</view>
      <view class="board-title">{{board.monthText}} 结余</view>
      <view class="board-arrow" bindtap="nextMonth">›</view>
    </view>
    <view class="board-balance {{board.balancePositive ? 'pos' : 'neg'}}">
      <text class="bb-label">本月结余</text>
      <view class="bb-num">{{board.balance}}</view>
    </view>
    <view class="overview-grid">
      <view class="ov-item">
        <view class="ov-num income">{{board.income}}</view>
        <view class="ov-label">收入</view>
      </view>
      <view class="ov-item">
        <view class="ov-num expense">{{board.expense}}</view>
        <view class="ov-label">支出</view>
      </view>
      <view class="ov-item">
        <view class="ov-num repay">{{board.repay}}</view>
        <view class="ov-label">已还</view>
      </view>
    </view>
    <view class="board-formula">
      收入 − 支出 − 已还 = 结余
      <text wx:if="{{board.isThisMonth}}" class="board-current">当前月</text>
    </view>
    <view class="share-btn" bindtap="openShare">生成账单卡片</view>
  </view>

  <!-- 近 6 个月收支趋势 -->
  <view class="card">
    <view class="trend-head">
      <view class="card-title">收支趋势</view>
      <view class="trend-legend">
        <view class="lg"><view class="dot dot-income"></view>收入</view>
        <view class="lg"><view class="dot dot-expense"></view>支出</view>
        <view class="lg"><view class="dot dot-balance"></view>结余</view>
      </view>
    </view>
    <canvas type="2d" id="trendCanvas" class="trend-canvas" wx:if="{{!trendEmpty && !showProfile && !showShare}}"></canvas>
    <view wx:elif="{{trendEmpty}}" class="empty">近 6 个月暂无收支数据</view>
  </view>

  <!-- 记一笔快捷入口 -->
  <view class="quick-add" catchtap="quickExpense">＋</view>

  <!-- 设置弹层 -->
  <view wx:if="{{showProfile}}" class="mask {{showProfileClosing ? 'mask-out' : ''}}" bindtap="closeProfile"></view>
  <view wx:if="{{showProfile}}" class="sheet {{showProfileClosing ? 'sheet-out' : ''}}">
    <view class="sheet-title">个人设置</view>

    <view class="form-item avatar-row">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{formAvatar}}" class="avatar-lg" src="{{formAvatar}}" mode="aspectFill" />
        <view wx:else class="avatar-lg placeholder">选</view>
      </button>
      <view class="avatar-tip">点击选择微信头像</view>
    </view>

    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" type="nickname" placeholder="填写昵称（自愿）" value="{{formNickname}}" bindinput="onNickInput" />
    </view>

    <view class="form-item">
      <text class="form-label">每月发薪日</text>
      <picker mode="selector" range="{{paydayRange}}" value="{{formPayday - 1}}" bindchange="onPaydayChange">
        <view class="form-input picker-val">每月 {{formPayday}} 号</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">每月开销预算（元）</text>
      <input class="form-input" type="number" placeholder="如 4000" value="{{formBudget}}" bindinput="onBudgetInput" />
    </view>

    <view class="form-item">
      <text class="form-label">隐私锁</text>
      <picker range="{{privacyOptions}}" value="{{privacyIndex}}" bindchange="onPrivacyChange">
        <view class="form-input picker-val">{{privacyOptions[privacyIndex]}}</view>
      </picker>
    </view>

    <view class="form-item recycle-entry" bindtap="openRecycle">
      <text class="form-label">回收站</text>
      <view class="recycle-link">已删记录保留 {{recycleDays}} 天 ›</view>
    </view>

    <view class="sheet-actions">
      <view class="btn btn-primary" bindtap="saveProfile">保存设置</view>
      <view class="btn btn-danger clear-btn" bindtap="clearData">重置全部数据</view>
    </view>
  </view>

  <!-- 月度账单分享弹层 -->
  <view wx:if="{{showShare}}" class="mask {{showShareClosing ? 'mask-out' : ''}}" bindtap="closeShare"></view>
  <view wx:if="{{showShare}}" class="share-pop {{showShareClosing ? 'share-pop-out' : ''}}">
    <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
    <view class="share-actions">
      <view class="btn btn-share" bindtap="saveShareImage">保存到相册</view>
      <view class="btn btn-primary" bindtap="shareToFriend">分享给好友</view>
    </view>
  </view>

  <!-- 最优还款顺序完整 sheet -->
  <view wx:if="{{showOptimalSheet}}" class="mask {{showOptimalSheetClosing ? 'mask-out' : ''}}" bindtap="closeOptimalSheet"></view>
  <view wx:if="{{showOptimalSheet}}" class="sheet {{showOptimalSheetClosing ? 'sheet-out' : ''}}">
    <view class="sheet-title">最优还款顺序</view>
    <view class="opt-tip">
      <text>建议在每张卡的还款日前 1-3 天再还，把免息期吃满。按当前未还 {{optimalFull.pendingCount}} 张卡估算：</text>
      <text class="opt-tip-saved">{{optimalFull.savedInterestText}}</text>
    </view>
    <scroll-view scroll-y="{{true}}" class="opt-list" enhanced="{{true}}" bounces="{{false}}">
      <view wx:for="{{optimalFull.order}}" wx:key="id" class="opt-row {{item.level}}">
        <view class="opt-rank">{{index + 1}}</view>
        <view class="opt-row-main">
          <view class="opt-row-top">
            <text class="opt-row-bank">{{item.bank}}</text>
            <view class="tag tag-red" wx:if="{{item.level === 'overdue'}}">已逾期</view>
            <view class="tag tag-red" wx:elif="{{item.level === 'urgent' && item.daysLeft === 0}}">今天</view>
            <view class="tag tag-yellow" wx:elif="{{item.level === 'urgent'}}">明天</view>
            <view class="tag tag-yellow" wx:elif="{{item.level === 'soon'}}">{{item.daysLeft}} 天后</view>
            <view class="tag tag-navy" wx:else>{{item.daysLeft}} 天后</view>
          </view>
          <view class="opt-row-amt">¥{{item.amountText}}</view>
          <view class="opt-row-meta">
            到期日 {{item.dueDate}}
            <text wx:if="{{item.freeDays > 0}}"> · 免息期 {{item.freeDays}} 天</text>
            <text wx:else> · 未设账单日</text>
          </view>
          <view class="opt-row-suggest">建议：{{item.suggestText}}</view>
        </view>
        <view class="btn btn-sm btn-primary opt-row-btn" bindtap="markPaid" data-id="{{item.id}}">标记已还</view>
      </view>
    </scroll-view>
    <view class="sheet-actions">
      <view class="btn btn-primary" bindtap="closeOptimalSheet">收下</view>
    </view>
  </view>
</view>
