.page {
  /* FAB 右下角悬浮，底部需足够留白 */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 月度结余看板（装在与卡片流一致的 .card 内，浅色/深色均自动适配） */
.board-card {
  padding-top: 28rpx;
}

.board-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.board-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 64rpx;
  color: var(--text-sub);
  background: var(--input-bg);
  border-radius: 50%;
}
.board-arrow:active {
  background: var(--press-bg);
}

.board-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-sub);
  letter-spacing: 0.02em;
}

.board-balance {
  text-align: center;
  padding: 12rpx 0 28rpx;
}

.bb-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

.bb-num {
  font-size: 80rpx;
  font-weight: 700;
  margin-top: 6rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  letter-spacing: -0.02em;
}

.board-balance.pos .bb-num { color: var(--gold); }
.board-balance.neg .bb-num { color: var(--danger); }

/* 结转提示行：主数字下方小字，说明可用余额里有多少是上月结转来的 */
.bb-carry {
  font-size: 22rpx;
  margin-top: 8rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}
.bb-carry.pos { color: var(--text-sub); }
.bb-carry.neg { color: var(--danger); }

.overview-grid {
  display: flex;
  gap: 16rpx;
}

.ov-item {
  flex: 1;
  text-align: center;
  background: var(--input-bg);
  border-radius: 16rpx;
  padding: 18rpx 0 14rpx;
}

.ov-num {
  font-size: 30rpx;
  font-weight: 700;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}

.ov-num.income { color: var(--gold); }
.ov-num.expense { color: var(--text); }

.ov-label {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.board-formula {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--text-mute);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 账单分享按钮 */
.share-btn {
  margin-top: 24rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--navy-700);
  border: 2rpx solid var(--border);
  border-radius: 999rpx;
  background: var(--bg);
}
.share-btn:active {
  background: var(--press-bg);
}

/* 账本君说：看板内智能区块（日均可花以"人话"呈现，点击弹 chat sheet） */
.board-ai {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  background: var(--tint-gold-06);
  border: 1rpx solid var(--tint-gold-12);
  border-radius: 28rpx;
}
.board-ai-hover {
  opacity: 0.85;
}
.bai-avatar {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: visible;
  flex-shrink: 0;
  margin-right: 20rpx;
  box-shadow: 0 0 0 4rpx var(--tint-gold-12), 0 6rpx 16rpx var(--tint-gold-18);
}
.bai-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
}
.bai-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #E24B4A;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border: 3rpx solid var(--card);
  box-sizing: border-box;
}

/* ---- 角标/头像微动效（A+C 方案）---- */
/* C：角标呼吸脉冲——所有角标态通用，轻量不打扰 */
@keyframes bai-badge-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.25); }
}
.bai-badge-pulse {
  animation: bai-badge-pulse 1.6s ease-in-out infinite;
}
/* A：头像抖动——仅提醒类未读（信用卡/发薪日）触发，进页抖 2 次即停。
   播完停在 0deg，停留首页期间保持安静；transform 走合成层，低端机不掉帧 */
@keyframes bai-avatar-shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-8deg); }
  50% { transform: rotate(8deg); }
  75% { transform: rotate(-4deg); }
}
.bai-avatar-shake {
  animation: bai-avatar-shake 0.8s ease-in-out 2 both;
}
/* 系统减弱动态效果时禁用（部分安卓机型支持） */
@media (prefers-reduced-motion: reduce) {
  .bai-badge-pulse,
  .bai-avatar-shake { animation: none; }
}
.bai-main {
  flex: 1;
  min-width: 0;
}
.bai-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.bai-reminder-icon {
  margin-right: 4rpx;
}
.bai-amt {
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--gold);
  margin: 0 4rpx;
}
.bai-sub {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* S3 缺发薪日：副文案为估算口径说明，金色提示引导去设置（设计稿 .bai-sub-hint） */
.bai-sub-hint {
  color: var(--gold-700);
}
.bai-arrow {
  font-size: 36rpx;
  color: var(--text-mute);
  line-height: 1;
  margin-left: 12rpx;
  flex-shrink: 0;
}
/* 空态引导动作按钮（去设置/去记账）：金色渐变胶囊，catchtap 与整块点击分离 */
.bai-action {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--gold), var(--gold-700));
  color: var(--navy-900);
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx var(--tint-gold-18);
}
.bai-action:active {
  opacity: 0.85;
}

/* 收支趋势图 */
.trend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.trend-head .card-title {
  margin-bottom: 0;
}
.trend-legend {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}
.trend-legend .lg {
  display: flex;
  align-items: center;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  margin-right: 6rpx;
}
.dot-income { background: var(--navy-700); }
.dot-expense { background: var(--danger); }
.dot-balance { background: var(--gold); border-radius: 50%; }
.trend-canvas {
  width: 100%;
  height: 340rpx;
  display: block;
  position: relative;
  z-index: 1;
}

/* 待办账务（T1.5：标题+二级入口） */
.todo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.todo-head .card-title {
  margin-bottom: 0;
}
.todo-sub-link {
  font-size: 24rpx;
  color: var(--gold-700, #A98436);
  font-weight: 500;
  padding: 4rpx 8rpx;
}
.todo-sub-link:active {
  opacity: 0.6;
}

/* 今天要处理 */
.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--input-bg);
  border-radius: 16rpx;
  padding: 22rpx;
  margin-top: 16rpx;
  border-left: 8rpx solid transparent;
}
.todo-item:first-of-type {
  margin-top: 0;
}

.todo-item.overdue {
  border-left-color: var(--danger);
  background: var(--danger-bg);
}
.todo-item.today {
  border-left-color: var(--gold);
  background: var(--gold-light);
}
.todo-item.tomorrow {
  border-left-color: var(--warn);
  background: var(--warn-bg);
}

.todo-main {
  flex: 1;
  min-width: 0;
}

.todo-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.todo-bank {
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 12rpx;
  color: var(--text);
}

.todo-platform {
  font-size: 22rpx;
  color: var(--text-mute);
  margin-right: 8rpx;
}

.todo-amount {
  font-size: 34rpx;
  font-weight: 800;
  margin-top: 8rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  color: var(--text);
}

.todo-due {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.todo-item.overdue .todo-due {
  color: var(--danger);
  font-weight: 600;
}

.pay-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.todo-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 36rpx;
  color: var(--text-mute);
  line-height: 1;
}

/* 最优还款顺序（多卡用户专属入口） */
.opt-card {
  /* 复用 .card */
}
.opt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.opt-titles {
  flex: 1;
  min-width: 0;
}
.opt-sub {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}
.opt-arrow {
  font-size: 40rpx;
  color: var(--text-mute);
  line-height: 1;
  padding-left: 16rpx;
}

.opt-preview-row {
  display: flex;
  align-items: center;
  background: var(--input-bg);
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
}
.opt-prev-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
  color: #fff;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  flex-shrink: 0;
}
.opt-prev-info {
  flex: 1;
  min-width: 0;
}
.opt-prev-bank {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.opt-prev-amount {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 2rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}
.opt-prev-due {
  font-size: 24rpx;
  color: var(--danger);
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 完整 sheet */
.opt-tip {
  background: var(--input-bg);
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.55;
  margin-bottom: 16rpx;
}
.opt-tip-saved {
  color: var(--gold);
  font-weight: 700;
  margin-left: 4rpx;
}

.opt-list {
  max-height: 60vh;
  /* scroll-view 需要显式高度才能滚动 */
  height: 60vh;
}
.opt-row {
  display: flex;
  align-items: center;
  background: var(--input-bg);
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 14rpx;
  border-left: 8rpx solid transparent;
}
.opt-row:last-child {
  margin-bottom: 0;
}
.opt-row.overdue {
  border-left-color: var(--danger);
  background: var(--danger-bg);
}
.opt-row.urgent {
  border-left-color: var(--gold);
  background: var(--gold-light);
}
.opt-row.soon {
  border-left-color: var(--warn);
  background: var(--warn-bg);
}
.opt-row.normal {
  border-left-color: var(--navy-300);
}

.opt-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--card-bg);
  border: 2rpx solid var(--navy-300);
  color: var(--text);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  flex-shrink: 0;
}
.opt-row.overdue .opt-rank {
  background: var(--danger);
  color: #fff;
  border-color: var(--danger);
}
.opt-row.urgent .opt-rank {
  background: var(--gold);
  color: #fff;
  border-color: var(--gold);
}

.opt-row-main {
  flex: 1;
  min-width: 0;
}
.opt-row-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.opt-row-bank {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}
.opt-row-amt {
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 6rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  color: var(--text);
}
.opt-row-meta {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}
.opt-row-suggest {
  font-size: 22rpx;
  color: var(--gold);
  font-weight: 600;
  margin-top: 6rpx;
}
.opt-row-btn {
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 预算预警 */
.budget-alert {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
}
.budget-alert.over {
  background: var(--danger-bg);
  border: 1rpx solid var(--danger-border);
}
.budget-alert.warn {
  background: var(--warn-bg);
  border: 1rpx solid var(--warn-border);
}

.ba-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.budget-alert.over .ba-dot { background: var(--danger); }
.budget-alert.warn .ba-dot { background: var(--warn); }

.ba-text {
  font-size: 26rpx;
  line-height: 1.5;
}
.budget-alert.over .ba-text { color: var(--danger); font-weight: 600; }
.budget-alert.warn .ba-text { color: var(--warn); font-weight: 600; }

/* 分享弹层（居中对话框） */
.share-pop {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 100;
  width: 640rpx;
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  animation: shareIn 0.26s cubic-bezier(0.32, 0.72, 0.34, 1);
}

.share-pop-out {
  animation: shareOut 0.22s ease forwards;
}

@keyframes shareIn {
  from { opacity: 0; transform: translate(-50%, -50%) scale(0.88); }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

@keyframes shareOut {
  from { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  to { opacity: 0; transform: translate(-50%, -50%) scale(0.92); }
}

.share-canvas {
  width: 576rpx;
  height: 768rpx;
  border-radius: 16rpx;
  background: var(--navy-800);
  display: block;
  margin: 0 auto;
}

.share-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.share-actions .btn {
  flex: 1;
}

.btn-share {
  background: var(--bg);
  color: var(--text);
}

/* 上次会话摘要 */
.ai-chat-last {
  background: var(--input-bg);
  border: 1rpx solid var(--border-light);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin: 16rpx 28rpx;
}
.ai-chat-last-label {
  font-size: 20rpx;
  color: var(--text-mute);
  margin-bottom: 8rpx;
}
.ai-chat-last-msg {
  display: flex;
  align-items: flex-start;
  margin-top: 6rpx;
}
.ai-chat-last-msg.mine {
  justify-content: flex-end;
}
.ai-chat-last-msg.his .chat-avatar-sm {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.chat-avatar-sm-img {
  width: 100%;
  height: 100%;
}
.ai-chat-last-bubble {
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.5;
  background: var(--card);
  border: 1rpx solid var(--border-light);
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  max-width: 70%;
  word-break: break-word;
}

/* 账本君主动询问气泡(订阅消息推送后展示) */
.ai-chat-pending {
  padding: 20rpx 24rpx 18rpx;
  margin: 16rpx 28rpx;
  background: linear-gradient(135deg, var(--gold-light), #fff8e7);
  border-radius: 20rpx;
  border: 1rpx solid var(--gold-light);
  box-shadow: 0 6rpx 20rpx var(--tint-gold-12);
}
.ai-chat-pending-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.ai-chat-pending-tag {
  font-size: 22rpx;
  color: var(--gold-700);
  font-weight: 600;
}
.ai-chat-pending-dismiss {
  font-size: 22rpx;
  color: var(--text-mute);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.ai-chat-pending-dismiss:active {
  background: rgba(0, 0, 0, 0.05);
}
.ai-chat-pending-bubble {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.55;
}
.ai-chat-pending-hint {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
}

/* 首次引导卡:让账本君主动关心你(未订阅时提示一次) */
.ai-chat-prompt-card {
  padding: 20rpx 24rpx 18rpx;
  margin: 16rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 2rpx dashed var(--gold-light);
}
.ai-chat-prompt-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 6rpx;
}
.ai-chat-prompt-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.5;
  margin-bottom: 14rpx;
}
.ai-chat-prompt-actions {
  display: flex;
  gap: 16rpx;
}
.ai-chat-prompt-later {
  background: var(--input-bg);
  color: var(--text-sub);
}

/* profile 设置里订阅开关下的提示文字 */
.form-tip {
  font-size: 22rpx;
  color: var(--text-sub);
  margin: -16rpx 24rpx 16rpx;
  line-height: 1.5;
}

/* ---------- 首屏骨架屏（board 未就绪时的占位，分阶段加载方案A） ---------- */
.board-skeleton {
  padding: 32rpx;
}
.sk-line,
.sk-num {
  background: var(--sk-bg, rgba(127, 127, 127, 0.14));
  border-radius: 10rpx;
  animation: sk-pulse 1.1s ease-in-out infinite;
}
.sk-row {
  display: flex;
  gap: 24rpx;
}
.sk-center {
  justify-content: center;
}
.sk-w80 {
  width: 220rpx;
  height: 30rpx;
}
.sk-num-wrap {
  display: flex;
  justify-content: center;
  padding: 36rpx 0 44rpx;
}
.sk-num {
  width: 420rpx;
  height: 88rpx;
  border-radius: 14rpx;
}
.sk-grid {
  justify-content: space-around;
}
.sk-half {
  width: 200rpx;
  height: 48rpx;
}
@keyframes sk-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.45;
  }
}
