.page {
  /* FAB 右下角悬浮，底部需足够留白 */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 月度结余看板（装在与卡片流一致的 .card 内，浅色/深色均自动适配） */
.board-card {
  padding-top: 28rpx;
}

.board-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.board-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 64rpx;
  color: var(--text-sub);
  background: var(--input-bg);
  border-radius: 50%;
}
.board-arrow:active {
  background: var(--press-bg);
}

.board-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-sub);
  letter-spacing: 0.02em;
}

.board-balance {
  text-align: center;
  padding: 12rpx 0 28rpx;
}

.bb-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

.bb-num {
  font-size: 80rpx;
  font-weight: 700;
  margin-top: 6rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  letter-spacing: -0.02em;
}

.board-balance.pos .bb-num { color: var(--gold); }
.board-balance.neg .bb-num { color: var(--danger); }

.overview-grid {
  display: flex;
  gap: 16rpx;
}

.ov-item {
  flex: 1;
  text-align: center;
  background: var(--input-bg);
  border-radius: 16rpx;
  padding: 18rpx 0 14rpx;
}

.ov-num {
  font-size: 30rpx;
  font-weight: 700;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}

.ov-num.income { color: var(--gold); }
.ov-num.expense { color: var(--text); }
.ov-num.repay { color: var(--text-sub); }

.ov-label {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.board-formula {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--text-mute);
  display: flex;
  align-items: center;
  justify-content: center;
}

.board-current {
  margin-left: 12rpx;
  background: var(--tint-gold-06);
  color: var(--gold);
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* 账单分享按钮 */
.share-btn {
  margin-top: 24rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--navy-700);
  border: 2rpx solid var(--border);
  border-radius: 999rpx;
  background: var(--bg);
}
.share-btn:active {
  background: var(--press-bg);
}

/* 账本君入口卡（趋势图上方，点击弹 AI 聊天框） */
.ai-entry-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
}
.ai-entry-card:active {
  opacity: 0.85;
}
.ai-entry-card .ai-entry-avatar {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold), #E8B85E);
  color: var(--navy-900);
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 0 4rpx var(--tint-gold-12), 0 8rpx 20rpx var(--tint-gold-18);
}
.ai-entry-card .ai-entry-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #E24B4A;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border: 3rpx solid var(--card);
  box-sizing: border-box;
}
.ai-entry-text {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.ai-entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}
.ai-entry-sub {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}
.ai-entry-arrow {
  font-size: 40rpx;
  color: var(--text-mute);
  line-height: 1;
  margin-left: 8rpx;
}

/* 收支趋势图 */
.trend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.trend-head .card-title {
  margin-bottom: 0;
}
.trend-legend {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}
.trend-legend .lg {
  display: flex;
  align-items: center;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  margin-right: 6rpx;
}
.dot-income { background: var(--navy-700); }
.dot-expense { background: var(--danger); }
.dot-balance { background: var(--gold); border-radius: 50%; }
.trend-canvas {
  width: 100%;
  height: 340rpx;
  display: block;
  position: relative;
  z-index: 1;
}

/* 今天要处理 */
.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--input-bg);
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid transparent;
}
.todo-item:last-child {
  margin-bottom: 0;
}

.todo-item.overdue {
  border-left-color: var(--danger);
  background: var(--danger-bg);
}
.todo-item.today {
  border-left-color: var(--gold);
  background: var(--gold-light);
}
.todo-item.tomorrow {
  border-left-color: var(--warn);
  background: var(--warn-bg);
}

.todo-main {
  flex: 1;
  min-width: 0;
}

.todo-top {
  display: flex;
  align-items: center;
}

.todo-bank {
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 12rpx;
  color: var(--text);
}

.todo-amount {
  font-size: 34rpx;
  font-weight: 800;
  margin-top: 8rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  color: var(--text);
}

.todo-due {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.todo-item.overdue .todo-due {
  color: var(--danger);
  font-weight: 600;
}

.pay-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 最优还款顺序（多卡用户专属入口） */
.opt-card {
  /* 复用 .card */
}
.opt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.opt-titles {
  flex: 1;
  min-width: 0;
}
.opt-sub {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}
.opt-arrow {
  font-size: 40rpx;
  color: var(--text-mute);
  line-height: 1;
  padding-left: 16rpx;
}

.opt-preview-row {
  display: flex;
  align-items: center;
  background: var(--input-bg);
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
}
.opt-prev-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
  color: #fff;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  flex-shrink: 0;
}
.opt-prev-info {
  flex: 1;
  min-width: 0;
}
.opt-prev-bank {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.opt-prev-amount {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 2rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}
.opt-prev-due {
  font-size: 24rpx;
  color: var(--danger);
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 完整 sheet */
.opt-tip {
  background: var(--input-bg);
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.55;
  margin-bottom: 16rpx;
}
.opt-tip-saved {
  color: var(--gold);
  font-weight: 700;
  margin-left: 4rpx;
}

.opt-list {
  max-height: 60vh;
  /* scroll-view 需要显式高度才能滚动 */
  height: 60vh;
}
.opt-row {
  display: flex;
  align-items: center;
  background: var(--input-bg);
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 14rpx;
  border-left: 8rpx solid transparent;
}
.opt-row:last-child {
  margin-bottom: 0;
}
.opt-row.overdue {
  border-left-color: var(--danger);
  background: var(--danger-bg);
}
.opt-row.urgent {
  border-left-color: var(--gold);
  background: var(--gold-light);
}
.opt-row.soon {
  border-left-color: var(--warn);
  background: var(--warn-bg);
}
.opt-row.normal {
  border-left-color: var(--navy-300);
}

.opt-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--card-bg);
  border: 2rpx solid var(--navy-300);
  color: var(--text);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  flex-shrink: 0;
}
.opt-row.overdue .opt-rank {
  background: var(--danger);
  color: #fff;
  border-color: var(--danger);
}
.opt-row.urgent .opt-rank {
  background: var(--gold);
  color: #fff;
  border-color: var(--gold);
}

.opt-row-main {
  flex: 1;
  min-width: 0;
}
.opt-row-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.opt-row-bank {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}
.opt-row-amt {
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 6rpx;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  color: var(--text);
}
.opt-row-meta {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}
.opt-row-suggest {
  font-size: 22rpx;
  color: var(--gold);
  font-weight: 600;
  margin-top: 6rpx;
}
.opt-row-btn {
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 预算预警 */
.budget-alert {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
}
.budget-alert.over {
  background: var(--danger-bg);
  border: 1rpx solid var(--danger-border);
}
.budget-alert.warn {
  background: var(--warn-bg);
  border: 1rpx solid var(--warn-border);
}

.ba-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.budget-alert.over .ba-dot { background: var(--danger); }
.budget-alert.warn .ba-dot { background: var(--warn); }

.ba-text {
  font-size: 26rpx;
  line-height: 1.5;
}
.budget-alert.over .ba-text { color: var(--danger); font-weight: 600; }
.budget-alert.warn .ba-text { color: var(--warn); font-weight: 600; }

/* 分享弹层（居中对话框） */
.share-pop {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 100;
  width: 640rpx;
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  animation: shareIn 0.26s cubic-bezier(0.32, 0.72, 0.34, 1);
}

.share-pop-out {
  animation: shareOut 0.22s ease forwards;
}

@keyframes shareIn {
  from { opacity: 0; transform: translate(-50%, -50%) scale(0.88); }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

@keyframes shareOut {
  from { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  to { opacity: 0; transform: translate(-50%, -50%) scale(0.92); }
}

.share-canvas {
  width: 576rpx;
  height: 768rpx;
  border-radius: 16rpx;
  background: var(--navy-800);
  display: block;
  margin: 0 auto;
}

.share-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.share-actions .btn {
  flex: 1;
}

.btn-share {
  background: var(--bg);
  color: var(--text);
}

/* 账本君 AI 助理 chat sheet */
.ai-chat-sheet {
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: height 0.18s ease;
  padding: 0;
  box-sizing: border-box;
}

/* ---- 头部标题栏:通栏深蓝渐变条,IP 专属对话头部 ---- */
.ai-chat-title {
  display: flex;
  align-items: center;
  margin: 0;
  padding: 26rpx 28rpx 24rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent 40%),
    linear-gradient(135deg, var(--navy-700), var(--navy-900));
  color: #fff;
  flex-shrink: 0;
  position: relative;
}
.ai-chat-title::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(200, 160, 77, 0.55), transparent);
}
.ai-chat-avatar {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold), #E8B85E);
  color: var(--navy-900);
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
  box-shadow:
    0 0 0 4rpx rgba(255, 255, 255, 0.14),
    0 8rpx 20rpx rgba(0, 0, 0, 0.28);
}
/* 头像右下角在线状态点(纯 CSS 装饰,无功能) */
.ai-chat-title .ai-chat-avatar::after {
  content: '';
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #3FCF7E;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  box-sizing: content-box;
}
.ai-chat-title-text {
  flex: 1;
  min-width: 0;
}
.ai-chat-title-main {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 0.02em;
}
.ai-chat-title-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.66);
  margin-top: 3rpx;
}
/* 清空:半透明白胶囊,头部场景专用 */
.ai-chat-clear {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  flex-shrink: 0;
  margin-right: 10rpx;
}
.ai-chat-clear:active {
  background: rgba(255, 255, 255, 0.22);
}

/* 显式关闭按钮:避免 sheet 太顶时无法点 mask 关闭 */
.ai-chat-close {
  font-size: 28rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.92);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  flex-shrink: 0;
  line-height: 1;
}
.ai-chat-close:active {
  background: rgba(255, 255, 255, 0.24);
}

/* 上次会话摘要 */
.ai-chat-last {
  background: var(--input-bg);
  border: 1rpx solid var(--border-light);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin: 16rpx 28rpx;
}
.ai-chat-last-label {
  font-size: 20rpx;
  color: var(--text-mute);
  margin-bottom: 8rpx;
}
.ai-chat-last-msg {
  display: flex;
  align-items: flex-start;
  margin-top: 6rpx;
}
.ai-chat-last-msg.mine {
  justify-content: flex-end;
}
.ai-chat-last-msg.his .chat-avatar-sm {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--gold);
  color: var(--navy-900);
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.ai-chat-last-bubble {
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.5;
  background: var(--card);
  border: 1rpx solid var(--border-light);
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  max-width: 70%;
  word-break: break-word;
}

/* 主对话历史 */
.ai-chat-history {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 12rpx 28rpx 18rpx;
  box-sizing: border-box;
}
.ai-chat-msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}
.ai-chat-msg.mine {
  justify-content: flex-end;
}
/* 账本君气泡头像:金色渐变 + 白色细描边 + 微光,与头部头像同源 */
.ai-chat-msg .chat-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold), #E8B85E);
  color: var(--navy-900);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
  box-shadow:
    0 0 0 2rpx rgba(200, 160, 77, 0.22),
    0 4rpx 12rpx var(--tint-gold-18);
}
.ai-chat-bubble-wrap {
  display: flex;
  flex-direction: column;
  max-width: 76%;
  flex-shrink: 1;
  min-width: 0;
}
.ai-chat-bubble {
  font-size: 27rpx;
  line-height: 1.6;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  word-break: break-word;
  white-space: pre-wrap;
}
/* 用户气泡:香槟金渐变,右侧小尾,浮起感 */
.ai-chat-msg.mine .ai-chat-bubble {
  background: linear-gradient(135deg, var(--gold), #E8B85E);
  color: var(--navy-900);
  border-top-right-radius: 6rpx;
  box-shadow: 0 6rpx 18rpx var(--tint-gold-18);
}
/* 账本君气泡:白底细边,左侧小尾 */
.ai-chat-msg.his .ai-chat-bubble {
  background: var(--card);
  border: 1rpx solid var(--border-light);
  color: var(--text);
  border-top-left-radius: 6rpx;
  box-shadow: 0 4rpx 14rpx var(--shadow-card);
}
/* 账本君记账成功后的 5s 撤销气泡(assistant 消息下方小 chip) */
.ai-chat-undo {
  align-self: flex-start;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--gold);
  background: rgba(200, 160, 77, 0.12);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-top: 8rpx;
  border: 1rpx solid rgba(200, 160, 77, 0.3);
}
.ai-chat-undo-hover {
  opacity: 0.6;
}
/* 「再记一次」快捷确认:与撤销气泡同色系,虚线边框区分"待确认"状态 */
.ai-chat-reconfirm {
  align-self: flex-start;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--gold);
  background: rgba(200, 160, 77, 0.12);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-top: 8rpx;
  border: 1rpx dashed rgba(200, 160, 77, 0.45);
}
.ai-chat-msg.loading {
  align-items: center;
}
.ai-chat-msg.loading text {
  font-size: 24rpx;
  color: var(--text-mute);
  line-height: 1;
}
.ai-chat-msg.loading .ai-chat-spinner {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid var(--gold);
  border-top-color: transparent;
  animation: ai-spin 0.8s linear infinite;
  margin-right: 10rpx;
  flex-shrink: 0;
}
@keyframes ai-spin {
  to { transform: rotate(360deg); }
}

/* 输入框:底部操作栏(白底 + 顶部分割线,贴安全区) */
.ai-chat-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  margin-top: 0;
  background: var(--card);
  flex-shrink: 0;
}
.ai-chat-input {
  flex: 1;
  background: var(--input-bg);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  padding: 18rpx 26rpx;
  font-size: 27rpx;
  min-height: 40rpx;
  color: var(--text);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.ai-chat-input::placeholder {
  color: var(--text-mute);
}
.ai-chat-input:focus {
  outline: none;
  border-color: var(--gold);
  box-shadow: 0 0 0 4rpx var(--tint-gold-12);
}
.ai-chat-send {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--navy-900);
  background: linear-gradient(135deg, var(--gold), #E8B85E);
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx var(--tint-gold-18);
  transition: background 0.15s ease, color 0.15s ease, transform 0.08s ease;
}
.ai-chat-send:active {
  transform: scale(0.96);
  opacity: 0.9;
}
.ai-chat-send.disabled {
  background: var(--input-bg);
  color: var(--text-mute);
  box-shadow: none;
}

.ai-chat-error {
  text-align: center;
  font-size: 22rpx;
  color: var(--danger);
  padding: 6rpx 28rpx 4rpx;
  background: var(--card);
}

/* 账本君主动询问气泡(订阅消息推送后展示) */
.ai-chat-pending {
  padding: 20rpx 24rpx 18rpx;
  margin: 16rpx 28rpx;
  background: linear-gradient(135deg, var(--gold-light), #fff8e7);
  border-radius: 20rpx;
  border: 1rpx solid var(--gold-light);
  box-shadow: 0 6rpx 20rpx var(--tint-gold-12);
}
.ai-chat-pending-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.ai-chat-pending-tag {
  font-size: 22rpx;
  color: var(--gold-700);
  font-weight: 600;
}
.ai-chat-pending-dismiss {
  font-size: 22rpx;
  color: var(--text-mute);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.ai-chat-pending-dismiss:active {
  background: rgba(0, 0, 0, 0.05);
}
.ai-chat-pending-bubble {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.55;
}
.ai-chat-pending-hint {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
}

/* 首次引导卡:让账本君主动关心你(未订阅时提示一次) */
.ai-chat-prompt-card {
  padding: 20rpx 24rpx 18rpx;
  margin: 16rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 2rpx dashed var(--gold-light);
}
.ai-chat-prompt-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 6rpx;
}
.ai-chat-prompt-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.5;
  margin-bottom: 14rpx;
}
.ai-chat-prompt-actions {
  display: flex;
  gap: 16rpx;
}
.ai-chat-prompt-later {
  background: var(--input-bg);
  color: var(--text-sub);
}

/* profile 设置里订阅开关下的提示文字 */
.form-tip {
  font-size: 22rpx;
  color: var(--text-sub);
  margin: -16rpx 24rpx 16rpx;
  line-height: 1.5;
}

/* AI 输入区上方常驻快捷问题 chip,点一下即发 */
.ai-quick-chip-row {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 28rpx 12rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.ai-quick-chip-row::-webkit-scrollbar {
  display: none;
}
.ai-quick-chip {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-sub);
  background: var(--chip-bg);
  border: 1rpx solid var(--border-light, rgba(0, 0, 0, 0.06));
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  white-space: nowrap;
  line-height: 1.4;
}
.ai-quick-chip-hover {
  background: rgba(200, 160, 77, 0.12);
  color: var(--gold-700, #8a6d2b);
  border-color: rgba(200, 160, 77, 0.35);
}
