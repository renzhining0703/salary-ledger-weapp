.page {
  padding-bottom: 160rpx;
}

/* 顶部账单汇总（普通卡片，跟随主题） */
.bill-summary {
  display: flex;
  align-items: stretch;
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx 12rpx 30rpx;
  margin: 24rpx;
  box-shadow: 0 8rpx 28rpx var(--shadow-card);
  border: 1rpx solid var(--border-light);
}

.bs-item {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.bs-label {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.bs-val {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bs-val.bs-warn {
  color: var(--danger);
}

.bs-sub {
  font-size: 20rpx;
  color: var(--text-mute);
  margin-top: 6rpx;
}

/* 信用卡卡片：待还款 = 金色左边框强调，已还清 = 灰底细线 */
.card.cc-active {
  background: var(--card);
  border-left: 6rpx solid var(--gold);
  box-shadow: 0 8rpx 28rpx var(--shadow-card);
}

.card.cc-paid {
  background: var(--card);
  border-left: 6rpx solid var(--text-mute);
  opacity: 0.92;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.bank-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.card-body {
  display: flex;
  align-items: center;
}

.amount-block {
  flex: 1;
}

.amount-label {
  font-size: 24rpx;
  margin-bottom: 4rpx;
  color: var(--text-sub);
}

.amount {
  font-size: 48rpx;
  font-weight: 800;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  color: var(--text);
}
.cc-active .amount { color: var(--gold); }

.info-block {
  text-align: right;
}

.info-line {
  font-size: 26rpx;
  margin-top: 6rpx;
  color: var(--text);
}

.info-line.sub {
  color: var(--text-sub);
  font-size: 24rpx;
}

/* 状态标签（跟随主题） */
.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid currentColor;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 600;
}

.cc-active .tag-red {
  color: var(--danger);
  border-color: rgba(220, 80, 80, 0.45);
  background: var(--danger-bg);
}
.cc-active .tag-yellow {
  color: var(--gold-700);
  border-color: rgba(200, 160, 77, 0.45);
  background: var(--tint-gold-12);
}
.cc-active .tag-gray {
  color: var(--text-sub);
  border-color: var(--border);
  background: var(--chip-bg);
}
.cc-active .tag-green {
  color: var(--success);
  border-color: rgba(50, 160, 100, 0.4);
  background: rgba(50, 160, 100, 0.1);
}

.cc-paid .tag-red,
.cc-paid .tag-yellow,
.cc-paid .tag-gray,
.cc-paid .tag-green {
  color: var(--text-sub);
  border-color: var(--border);
  background: var(--chip-bg);
}

.overdue-text {
  color: var(--danger) !important;
  font-weight: 700;
}

.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.cc-active .btn-primary {
  background: linear-gradient(135deg, var(--gold), var(--gold-700));
  color: var(--navy-900);
  box-shadow: 0 8rpx 24rpx rgba(200, 160, 77, 0.3);
}

.cc-active .btn-ghost {
  background: var(--input-bg);
  color: var(--text);
  border: 1rpx solid var(--border);
}
.cc-active .btn-ghost:active {
  background: var(--press-bg);
}

.cc-active .btn-danger {
  background: var(--danger-bg);
  color: var(--danger);
}
.cc-active .btn-danger:active {
  background: rgba(220, 80, 80, 0.18);
}

.cc-paid .btn-primary,
.cc-paid .btn-ghost,
.cc-paid .btn-danger {
  opacity: 0.8;
}

/* 悬浮添加按钮样式见 app.wxss 全局 .fab */

.edit-tip {
  font-size: 24rpx;
  color: var(--text-sub);
  text-align: center;
  margin-top: -8rpx;
}

/* 底部操作区见 app.wxss 全局 .sheet-actions */
