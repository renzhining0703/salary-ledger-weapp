.page {
  padding-bottom: 160rpx;
}


.month-total {
  font-size: 68rpx;
  font-weight: 800;
  color: var(--navy-700);
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  letter-spacing: -0.02em;
  margin: 8rpx 0 20rpx;
}

.budget-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--text-sub);
}

.budget-label.over {
  color: var(--danger);
  font-weight: 700;
}

.budget-bar {
  height: 16rpx;
  background: var(--fill-bg);
  border-radius: 999rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.budget-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--navy-700), var(--gold));
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.budget-fill.over {
  background: var(--danger);
}

.compare-row {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 16rpx;
}

.over-tip {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--danger);
}

.over-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  background: var(--danger);
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

/* 分类占比 */
.cat-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.cat-name {
  width: 100rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}

.cat-bar {
  flex: 1;
  height: 18rpx;
  background: var(--fill-bg);
  border-radius: 999rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.cat-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--navy-700), var(--navy-600));
  border-radius: 999rpx;
}

.cat-amount {
  font-size: 24rpx;
  color: var(--text);
  flex-shrink: 0;
  min-width: 180rpx;
  text-align: right;
  font-weight: 600;
}

/* 流水 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.row:last-child {
  border-bottom: none;
}

.row-left {
  flex: 1;
  min-width: 0;
}

.row-top {
  display: flex;
  align-items: center;
}

.row-note {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
  margin-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-date {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.row-right {
  display: flex;
  align-items: center;
}

.row-amount {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--danger);
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}

.row-del {
  font-size: 24rpx;
  color: var(--danger);
  margin-left: 24rpx;
  padding: 8rpx;
}

/* 悬浮添加按钮样式见 app.wxss 全局 .fab */
/* 分类选择器已抽为公共组件 components/cat-grid（图标网格版），样式随组件走 */

/* ---------- 记一笔 × 固定支出联动 ---------- */
/* 本月待记固定支出快捷条：金色浅底引导，点一下预填表单并关联模板 */
.pending-recur {
  background: var(--tint-gold-06);
  border: 1rpx solid var(--tint-gold-12);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.pending-recur-label {
  font-size: 22rpx;
  color: var(--gold-700);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.pending-recur-row {
  white-space: nowrap;
}

.pending-recur-chip {
  display: inline-flex;
  align-items: baseline;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  background: var(--card);
  border: 1rpx dashed var(--gold);
  border-radius: 999rpx;
  margin-right: 16rpx;
  transition: transform 0.1s ease, opacity 0.1s ease;
}

.pending-recur-chip-hover {
  transform: scale(0.96);
  opacity: 0.85;
}

.prc-name {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

.prc-amount {
  font-size: 24rpx;
  color: var(--gold-700);
  font-weight: 700;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}

/* 已关联模板提示条：保存即标记本月已记，✕ 可解除 */
.linked-recur-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--tint-gold-06);
  border: 1rpx solid var(--gold);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.lrt-icon {
  font-size: 26rpx;
  line-height: 1;
}

.lrt-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--gold-700);
  font-weight: 500;
}

.lrt-close {
  font-size: 28rpx;
  color: var(--text-mute);
  padding: 4rpx 8rpx;
}

.amount-input {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--navy-700);
}

/* 记一笔弹框：标题/保存按钮固定，中间表单区在弹框内部滚动（配合 wxml 的 scroll-view，
   阻断滚动穿透；全局 .sheet 的 overflow-y:auto 被 overflow:hidden 覆盖） */
.form-sheet {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.form-scroll {
  /* scroll-view 需要固定高度才能内部滚动，不能用 max-height / flex 分配值 */
  height: 62vh;
}

/* picker-val / sheet-actions 见 app.wxss 全局定义 */
/* 月份切换头 */
.month-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.month-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.month-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 64rpx;
  color: var(--text-sub);
  border-radius: 12rpx;
}

.month-arrow:active {
  background: var(--press-bg);
}

.month-arrow.disabled {
  color: var(--text-mute);
}

.month-arrow.disabled:active {
  background: transparent;
}


/* ---------- 月度总览卡「查看本月账单」入口 ---------- */
.statement-link {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--navy-700);
  padding: 14rpx 0;
  border-top: 1rpx solid var(--border-light);
}

/* 账单线性图标：圆角纸 + 两条内容线，与 tab 图标线条语言一致 */
.stmt-ico {
  width: 30rpx;
  height: 36rpx;
  border: 3rpx solid var(--navy-700);
  border-radius: 6rpx;
  box-sizing: border-box;
  padding: 8rpx 6rpx 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex-shrink: 0;
}
.stmt-ico-line {
  height: 3rpx;
  width: 100%;
  background: var(--navy-700);
  border-radius: 2rpx;
}
.stmt-ico-line.short {
  width: 62%;
}


