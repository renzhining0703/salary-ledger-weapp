.page {
  padding-bottom: 160rpx;
}

/* 本月账单 sheet 打开期间,临时锁住 page 自身滚动
   防止 scroll-view 边界手势穿透,让外层 page 跟着滑动 */
.page.page-locked {
  overflow: hidden;
  height: 100vh;
}

.month-total {
  font-size: 68rpx;
  font-weight: 800;
  color: var(--navy-700);
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  letter-spacing: -0.02em;
  margin: 8rpx 0 20rpx;
}

.budget-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--text-sub);
}

.budget-label.over {
  color: var(--danger);
  font-weight: 700;
}

.budget-bar {
  height: 16rpx;
  background: var(--fill-bg);
  border-radius: 999rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.budget-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--navy-700), var(--gold));
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.budget-fill.over {
  background: var(--danger);
}

.compare-row {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 16rpx;
}

.over-tip {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--danger);
}

/* 分类占比 */
.cat-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.cat-name {
  width: 100rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}

.cat-bar {
  flex: 1;
  height: 18rpx;
  background: var(--fill-bg);
  border-radius: 999rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.cat-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--navy-700), var(--navy-600));
  border-radius: 999rpx;
}

.cat-amount {
  font-size: 24rpx;
  color: var(--text);
  flex-shrink: 0;
  min-width: 180rpx;
  text-align: right;
  font-weight: 600;
}

/* 流水 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.row:last-child {
  border-bottom: none;
}

.row-left {
  flex: 1;
  min-width: 0;
}

.row-top {
  display: flex;
  align-items: center;
}

.row-note {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
  margin-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-date {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.row-right {
  display: flex;
  align-items: center;
}

.row-amount {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--danger);
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}

.row-del {
  font-size: 24rpx;
  color: var(--danger);
  margin-left: 24rpx;
  padding: 8rpx;
}

/* 悬浮添加 */
.fab {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 56rpx;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 32rpx var(--shadow-deep);
  z-index: 50;
}
.fab:active {
  transform: translateX(-50%) scale(0.98);
  opacity: 0.94;
}

/* 分类 chips */
.cat-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  min-width: 120rpx;
  text-align: center;
  padding: 16rpx 28rpx;
  background: var(--chip-bg);
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  transition: all 0.1s ease;
}

.chip-active {
  background: linear-gradient(135deg, var(--navy-700), var(--navy-800));
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx var(--shadow-strong);
}

.amount-input {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--navy-700);
}

.picker-val {
  display: flex;
  align-items: center;
  color: var(--text);
}

.sheet-actions {
  margin-top: 32rpx;
}

/* 月份切换头 */
.month-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.month-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.month-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 64rpx;
  color: var(--text-sub);
  border-radius: 12rpx;
}

.month-arrow:active {
  background: var(--press-bg);
}

.month-arrow.disabled {
  color: var(--text-mute);
}

.month-arrow.disabled:active {
  background: transparent;
}

/* 固定支出入口卡片 */
.recur-card:active {
  background: var(--press-bg);
}

.recur-summary {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin: 4rpx 0 8rpx;
}

.recur-total {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--navy-700);
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}

.recur-sub {
  font-size: 24rpx;
  color: var(--text-sub);
}

.recur-hint {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 固定支出管理弹层 */
.recur-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
  gap: 16rpx;
}

.recur-row.inactive .recur-name,
.recur-row.inactive .recur-meta,
.recur-row.inactive .recur-amount {
  color: var(--text-mute);
}

.recur-info {
  flex: 1;
  min-width: 0;
}

.recur-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.recur-meta {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.recur-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.recur-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--navy-700);
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
}

.recur-del {
  font-size: 24rpx;
  color: var(--danger);
  padding: 8rpx 4rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-tip {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

/* 手动确认记账按钮 */
.recur-tip {
  font-size: 24rpx;
  color: var(--text-sub);
  margin: -8rpx 0 16rpx;
}

.recur-record {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--gold);
  border: 2rpx solid var(--gold);
  border-radius: 999rpx;
  background: var(--tint-gold-06);
  white-space: nowrap;
}

.recur-record:active {
  background: var(--tint-gold-18);
}

.recur-record.done {
  color: var(--text-mute);
  border-color: var(--border);
  background: var(--chip-bg);
}

.recur-done-text {
  color: var(--gold);
}

/* 固定支出「每月自动落账」开关行 */
.recur-auto {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  /* 避免按钮按下态被外层 .recur-row:active 干扰 */
  pointer-events: auto;
}

.recur-auto-label {
  font-size: 22rpx;
  color: var(--text-sub);
}

/* switch 缩放:原生的 64rpx 偏大,缩到 56rpx 配合小字 label */
.recur-auto switch {
  transform: scale(0.85);
  transform-origin: right center;
}

/* ---------- 月度总览卡「查看本月账单」入口 ---------- */
.statement-link {
  margin-top: 18rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--navy-700);
  padding: 14rpx 0;
  border-top: 1rpx solid var(--border-light);
}

/* ---------- 本月账单 sheet ---------- */
.statement-sheet {
  /* 改 flex 列布局:title 在上 / scroll-view 占中间 / 底部按钮固定 */
  display: flex;
  flex-direction: column;
  /* 高度收一点,留 18vh 给遮罩外的视觉呼吸 */
  max-height: 82vh;
  /* 关闭 sheet 自身滚动,交给内部 scroll-view */
  overflow: hidden;
}

/* 内容滚动区:占满中间,只滚这里 */
.statement-scroll {
  flex: 1;
  /* flex 子项允许缩小到内容以下,scroll-view 才能拿到剩余高度 */
  min-height: 0;
  /* 抵消全局 .sheet 的左右 padding,内部内容再靠 32rpx 内 padding 居中 */
  margin: 0 -32rpx;
  padding: 0 32rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* 底部按钮固定不跟随内容滚动 */
.statement-bottom {
  flex-shrink: 0;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
}

.stmt-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.stmt-cell {
  flex: 1;
  text-align: center;
  background: var(--input-bg);
  border-radius: 16rpx;
  padding: 18rpx 8rpx;
}

.stmt-cell-label {
  font-size: 22rpx;
  color: var(--text-sub);
}

.stmt-cell-num {
  font-size: 28rpx;
  font-weight: 800;
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  margin-top: 6rpx;
}
.stmt-cell-num.income { color: var(--navy-700); }
.stmt-cell-num.expense { color: var(--text); }
.stmt-cell-num.pos { color: var(--gold); }
.stmt-cell-num.neg { color: var(--danger); }

.stmt-savings {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 20rpx;
}

.stmt-savings-num {
  font-weight: 800;
  font-size: 30rpx;
  margin-left: 6rpx;
}
.stmt-savings-num.good { color: var(--success); }
.stmt-savings-num.mid { color: var(--warn); }
.stmt-savings-num.bad { color: var(--danger); }

.stmt-compare {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stmt-cmp-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  border: 1rpx solid var(--border-light);
  border-radius: 14rpx;
}

.stmt-cmp-label {
  font-size: 22rpx;
  color: var(--text-sub);
}

.stmt-cmp-val {
  font-size: 28rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  margin-top: 4rpx;
}
.stmt-cmp-val.muted {
  color: var(--text-mute);
  font-family: inherit;
  font-weight: 500;
}

.stmt-cmp-pct {
  font-size: 20rpx;
  font-weight: 600;
  margin-top: 2rpx;
}
.stmt-cmp-pct.up { color: var(--danger); }
.stmt-cmp-pct.down { color: var(--success); }
.stmt-cmp-pct.flat { color: var(--text-mute); }
.stmt-cmp-pct.muted { color: var(--text-mute); font-weight: 400; }

/* 饼图已删除 — 原 .stmt-pie-wrap / .stmt-pie-canvas 样式一并清理 */

.stmt-cats {
  margin-bottom: 24rpx;
}

.stmt-cat-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.stmt-cat-row:last-child { border-bottom: none; }

.stmt-cat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.stmt-cat-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  width: 96rpx;
  flex-shrink: 0;
}

.stmt-cat-bar {
  flex: 1;
  height: 12rpx;
  background: var(--fill-bg);
  border-radius: 999rpx;
  overflow: hidden;
}

.stmt-cat-fill {
  height: 100%;
  border-radius: 999rpx;
}

.stmt-cat-amt {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
  font-family: "DIN Alternate", sans-serif;
  min-width: 140rpx;
  text-align: right;
}

.stmt-cat-over {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--danger);
  background: var(--danger-bg);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.stmt-insight {
  background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
  color: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-top: 8rpx;
  box-shadow: 0 8rpx 24rpx var(--shadow-strong);
}

.stmt-insight-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.stmt-insight-title {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.stmt-insight-src {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.stmt-insight-refresh {
  color: var(--gold);
  font-weight: 600;
  padding: 4rpx 12rpx;
  border: 1rpx solid var(--gold);
  border-radius: 999rpx;
  font-size: 20rpx;
}
.stmt-insight-refresh:active {
  opacity: 0.8;
}

.stmt-insight-body {
  font-size: 26rpx;
  line-height: 1.65;
  white-space: pre-line;
  color: rgba(255, 255, 255, 0.92);
}

.stmt-insight-loading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  white-space: nowrap;
  color: rgba(255, 255, 255, 0.78);
}

.stmt-insight-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.28);
  border-top-color: var(--gold);
  border-radius: 50%;
  animation: stmt-spin 0.9s linear infinite;
  flex-shrink: 0;
}

@keyframes stmt-spin {
  to { transform: rotate(360deg); }
}

/* ---------- 账本君对话问答 ---------- */
.stmt-chat {
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  padding-top: 16rpx;
}

.stmt-chat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-bottom: 12rpx;
}

.stmt-chat-close {
  font-size: 22rpx;
  color: var(--gold);
  padding: 4rpx 14rpx;
  border: 1rpx solid var(--gold);
  border-radius: 999rpx;
}

.stmt-chat-close:active {
  opacity: 0.8;
}

.stmt-chat-history {
  max-height: 480rpx;
  min-height: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 14rpx;
  padding: 4rpx 0;
}

.stmt-chat-msg {
  display: flex;
  width: 100%;
  align-items: flex-start;
  /* 每条消息之间留间距(parent 的 gap 在某些情况下被覆盖,这里双保险) */
  margin-bottom: 18rpx;
}
.stmt-chat-msg:last-child {
  margin-bottom: 0;
}

.stmt-chat-msg.mine {
  justify-content: flex-end;
}

.stmt-chat-msg.his {
  justify-content: flex-start;
}

.stmt-chat-bubble {
  display: inline-block;
  max-width: 80%;
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 1.5;
  white-space: pre-line;
  word-break: break-word;
}

.stmt-chat-msg.mine .stmt-chat-bubble {
  background: var(--gold);
  color: var(--navy-900);
  border-bottom-right-radius: 4rpx;
}

.stmt-chat-msg.his .stmt-chat-bubble {
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.92);
  border-bottom-left-radius: 4rpx;
}

.stmt-chat-msg.his.loading {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  align-items: center;
  gap: 12rpx;
}

.stmt-chat-input-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.stmt-chat-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  min-height: 40rpx;
}

.stmt-chat-input::placeholder {
  color: rgba(255, 255, 255, 0.45);
}

.stmt-chat-send {
  background: var(--gold);
  color: var(--navy-900);
  font-size: 24rpx;
  font-weight: 700;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.stmt-chat-send:active {
  opacity: 0.85;
}

.stmt-chat-send.disabled {
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.4);
}

.stmt-chat-error {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #FFD7A8;
  text-align: center;
}

/* ---------- 消费日历热力图 ---------- */
.heatmap-card {
  /* 复用 .card 样式 */
}

.heatmap-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.heatmap-card-titles {
  flex: 1;
  min-width: 0;
}

.heatmap-card-sub {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.heatmap-card-arrow {
  font-size: 40rpx;
  color: var(--text-mute);
  line-height: 1;
  padding-left: 16rpx;
}

.heatmap-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  margin: 12rpx 0 14rpx;
}

.heatmap-mini-cell {
  width: 28rpx;
  height: 28rpx;
  border-radius: 5rpx;
  background: var(--heat-0);
}

.heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
}

.legend-text {
  font-size: 20rpx;
  color: var(--text-mute);
}

.legend-cell {
  width: 14rpx;
  height: 14rpx;
  border-radius: 3rpx;
  background: var(--heat-0);
}

/* 完整 sheet */
.heatmap-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  justify-content: center;
}

.heatmap-tab {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  background: var(--chip-bg);
  border-radius: 999rpx;
}

.heatmap-tab.active {
  background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
  color: #fff;
  font-weight: 600;
}

.heatmap-scroll {
  /* 横滚以支持 52 周 */
  white-space: nowrap;
  padding-bottom: 12rpx;
}

.heatmap-grid-wrap {
  display: inline-block;
  padding-left: 8rpx;
}

.heatmap-months {
  position: relative;
  height: 28rpx;
  font-size: 18rpx;
  color: var(--text-mute);
  margin-bottom: 6rpx;
}

.heatmap-month-label {
  position: absolute;
  top: 0;
}

.heatmap-grid {
  display: flex;
  gap: 4rpx;
  /* 不设 width:100% — 内容自然撑出,scroll-view 决定是否横滚 */
}

.heatmap-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  /* flex:1 让 13 列时平分 grid 宽度 → 自然撑满弹框;min-width 48rpx 兜底
     26/52 列时不被压太扁,触发横滚 */
  flex: 1 1 0;
  min-width: 48rpx;
}

.heatmap-cell {
  /* width 跟 col 平分,height 固定 48rpx 保持色块大小一致(矩形也可,不强求正方形) */
  width: 100%;
  height: 48rpx;
  border-radius: 8rpx;
  background: var(--heat-0);
}

.heatmap-cell.heat-1 { background: var(--heat-1); }
.heatmap-cell.heat-2 { background: var(--heat-2); }
.heatmap-cell.heat-3 { background: var(--heat-3); }
.heatmap-cell.heat-4 { background: var(--heat-4); }

.heatmap-cell.today {
  outline: 2rpx solid var(--gold);
  outline-offset: -2rpx;
}

.heatmap-cell:active {
  transform: scale(0.92);
}

.heatmap-stats {
  display: flex;
  background: var(--input-bg);
  border-radius: 16rpx;
  padding: 20rpx 0;
  margin: 16rpx 0;
}

.hs-item {
  flex: 1;
  text-align: center;
}

.hs-num {
  font-size: 30rpx;
  font-weight: 800;
  font-family: "DIN Alternate", sans-serif;
  color: var(--text);
}

.hs-label {
  font-size: 20rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

/* 单日 sheet */
.heatmap-day-sheet {
  max-height: 70vh;
}

.heatmap-day-total {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 16rpx;
}
