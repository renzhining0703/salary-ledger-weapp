<view class="page {{pageLocked ? 'page-locked' : ''}} {{themeClass}}">
  <!-- 自定义导航栏（navigationStyle: custom），跟随系统主题 -->
  <view class="navbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="navbar-inner">
      <view class="navbar-title">记账</view>
    </view>
  </view>

  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="sk-wrap">
    <view class="sk-card">
      <view class="sk-block sk-w30"></view>
      <view class="sk-block sk-w70 sk-xl sk-mt"></view>
      <view class="sk-block sk-w100 sk-mt round" style="height: 16rpx;"></view>
      <view class="sk-block sk-w40 sk-mt"></view>
    </view>
    <view class="sk-card">
      <view class="sk-block sk-w30 sk-mb"></view>
      <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="sk-row">
        <view class="sk-block sk-w20 sk-h round"></view>
        <view class="sk-block sk-w50"></view>
        <view class="sk-block sk-w30 sk-l"></view>
      </view>
    </view>
    <view class="sk-card">
      <view class="sk-block sk-w30 sk-mb"></view>
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="sk-row">
        <view class="sk-block sk-w40"></view>
        <view class="sk-block sk-w30 sk-l"></view>
      </view>
    </view>
  </view>

  <block wx:else>
    <!-- 月度总览 + 预算进度 -->
    <view class="card">
      <view class="month-head">
        <view class="month-arrow" bindtap="goPrevMonth">‹</view>
        <view class="month-title">{{monthText}} 开销</view>
        <view class="month-arrow {{isThisMonth ? 'disabled' : ''}}" bindtap="goNextMonth">›</view>
      </view>
      <view class="month-total" bindtap="openStatement">{{monthTotal}}</view>
      <view class="budget-row">
        <text class="budget-label">月预算 ¥{{budget}}</text>
        <text class="budget-label {{budgetOver ? 'over' : ''}}">{{budgetOver ? '已超支' : budgetPercent + '%'}}</text>
      </view>
      <view class="budget-bar">
        <view class="budget-fill {{budgetOver ? 'over' : ''}}" style="width: {{budgetPercent}}%"></view>
      </view>
      <view wx:if="{{budgetOver}}" class="over-tip">
        <view class="over-icon">!</view>
        <text>已超支 {{overAmount}}</text>
      </view>
      <view class="compare-row">上月同期：{{lastMonthTotal}}</view>
      <view class="statement-link" bindtap="openStatement">
        <view class="stmt-ico">
          <view class="stmt-ico-line"></view>
          <view class="stmt-ico-line short"></view>
        </view>
        <text>查看本月账单 ›</text>
      </view>
    </view>

    <!-- 分类占比：本月有消费才展示（用数值 _monthTotalNum 判断——monthTotal 是动画后的带前缀字符串 '¥0.00'，字符串比较不可靠） -->
    <view class="card" wx:if="{{_monthTotalNum > 0}}">
      <view class="card-title">分类占比</view>
      <view wx:for="{{catStats}}" wx:key="name" class="cat-row" wx:if="{{item.amount > 0}}">
        <view class="cat-name">{{item.name}}</view>
        <view class="cat-bar">
          <view class="cat-fill" style="width: {{item.percent}}%"></view>
        </view>
        <view class="cat-amount">¥{{item.amountText}} ({{item.percent}}%)</view>
      </view>
    </view>


    <!-- 流水列表 -->
    <view class="card">
      <view class="card-title">{{monthText}} 流水</view>
      <block wx:if="{{list.length}}">
        <view wx:for="{{list}}" wx:key="_id" class="row">
          <view class="row-left">
            <view class="row-top">
              <view class="tag tag-navy">{{item.category}}</view>
              <text class="row-note" wx:if="{{item.note}}">{{item.note}}</text>
            </view>
            <view class="row-date">{{item.date}}</view>
          </view>
          <view class="row-right">
            <view class="row-amount">¥{{item.amountText}}</view>
            <view class="row-del" bindtap="removeExpense" data-id="{{item._id}}" data-date="{{item.date}}" data-amount="{{item.amountText}}">删除</view>
          </view>
        </view>
      </block>
      <view wx:else class="empty">{{isThisMonth ? '本月还没有开销记录，点下方记一笔' : '该月没有开销记录'}}</view>
    </view>

    <!-- 悬浮添加 -->
    <view class="fab" bindtap="openForm">＋ 记一笔</view>
  </block>

  <!-- 记账表单 -->
  <view wx:if="{{showForm}}" class="mask {{showFormClosing ? 'mask-out' : ''}}" bindtap="closeForm"></view>
  <view wx:if="{{showForm}}" class="sheet {{showFormClosing ? 'sheet-out' : ''}}">
    <view class="sheet-title">记一笔开销</view>

    <view class="form-item">
      <text class="form-label">金额（元）</text>
      <input class="form-input amount-input" type="digit" placeholder="0.00" value="{{formAmount}}" bindinput="onAmountInput" focus="{{true}}" adjust-position="{{false}}" hold-keyboard="{{true}}" />
    </view>

    <view class="form-item">
      <text class="form-label">分类</text>
      <view class="cat-chips">
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          class="chip {{formCategory === item ? 'chip-active' : ''}}"
          bindtap="onCategoryTap"
          data-cat="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">日期</text>
      <picker mode="date" value="{{formDate}}" bindchange="onDateChange">
        <view class="form-input picker-val">{{formDate}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">备注（可选）</text>
      <input class="form-input" placeholder="如：午餐 / 地铁" value="{{formNote}}" bindinput="onNoteInput" />
    </view>

    <view class="sheet-actions">
      <view class="btn btn-primary" bindtap="saveExpense">保存</view>
    </view>
  </view>


  <!-- 本月账单 sheet -->
  <view wx:if="{{showStatement}}" class="mask {{showStatementClosing ? 'mask-out' : ''}}" bindtap="closeStatement"></view>
  <view wx:if="{{showStatement}}" class="sheet statement-sheet {{showStatementClosing ? 'sheet-out' : ''}}">
    <view class="sheet-title">{{statement.monthText}} 账单</view>

    <scroll-view class="statement-scroll" scroll-y="{{true}}" bounces="{{false}}" enhanced="{{true}}" scroll-top="{{stmtScrollTop}}">

    <!-- 结余 Hero：主数字 + 储蓄率徽章 + 三栏明细 -->
    <view class="stmt-hero">
      <view class="stmt-hero-top">
        <view class="stmt-hero-main">
          <view class="stmt-hero-label">可用余额</view>
          <view class="stmt-hero-num {{statement.balanceSign === '+' ? 'pos' : 'neg'}}">{{statement.balanceSign}}¥{{statement.balanceText}}</view>
          <view wx:if="{{statement.carriedOverText}}" class="stmt-carry-hint">{{statement.carriedOverText}}</view>
        </view>
        <view class="stmt-hero-badge">
          <view class="shb-num">{{statement.savingsRateText}}</view>
          <view class="shb-label">储蓄率</view>
        </view>
      </view>
      <view class="stmt-hero-grid">
        <view class="shg-item">
          <view class="shg-num gold">¥{{statement.incomeText}}</view>
          <view class="shg-label">累计收入</view>
        </view>
        <view class="shg-item">
          <view class="shg-num">¥{{statement.expenseText}}</view>
          <view class="shg-label">累计支出</view>
        </view>
      </view>
    </view>

    <!-- 对比上月（单行 chip） -->
    <view class="stmt-cmp-bar">
      <text class="stmt-cmp-label">较上月支出 ¥{{statement.momText}}</text>
      <view wx:if="{{statement.momDelta}}" class="stmt-cmp-pct {{statement.momDelta.dir}}">{{statement.momDelta.arrow}} {{statement.momDelta.pctText}}</view>
      <view wx:else class="stmt-cmp-pct flat">持平</view>
    </view>

    <!-- 分类明细(原饼图已去掉,canvas 在 overflow 容器内"飘"的问题不需要再处理) -->
    <view class="stmt-cats">
      <view wx:for="{{statement.categories}}" wx:key="name" class="stmt-cat-row {{item.isEmpty ? 'empty' : ''}}">
        <view class="stmt-cat-dot" style="background: {{item.color}};"></view>
        <view class="stmt-cat-name">{{item.name}}</view>
        <view class="stmt-cat-bar">
          <view class="stmt-cat-fill" style="width: {{item.percent}}%; background: {{item.color}};"></view>
        </view>
        <view class="stmt-cat-amt">¥{{item.amountText}}</view>
        <!-- 分类预算入口:已设显示金额,未设显示 +预算 引导 -->
        <view class="stmt-cat-budget {{item.budget > 0 ? 'set' : 'unset'}} {{item.over ? 'over' : ''}}"
              bindtap="onCatBudgetTap" data-cat="{{item.name}}" hover-class="stmt-cat-budget-hover">
          <text wx:if="{{item.budget > 0}}">¥{{item.budgetText}}</text>
          <text wx:else>+ 预算</text>
        </view>
        <view wx:if="{{item.over}}" class="stmt-cat-over">超</view>
      </view>
    </view>

    <!-- AI 解读卡 -->
    <view id="stmt-insight" class="stmt-insight">
      <view class="stmt-insight-head">
        <view class="stmt-insight-avatar"><image class="stmt-insight-avatar-img" src="/static/avatar/avatar-c-200.png" mode="aspectFill" /></view>
        <view class="stmt-insight-title">账本君</view>
        <view class="stmt-insight-src">
          <text wx:if="{{statement.insightSource === 'loading'}}">思考中…</text>
          <text wx:elif="{{statement.insightSource === 'cache'}}">缓存</text>
          <text wx:elif="{{statement.insightSource === 'llm'}}">AI</text>
          <text wx:elif="{{statement.insightSource === 'template-pending'}}">本地生成</text>
          <text wx:elif="{{statement.insightSource === 'template'}}">本地生成</text>
        </view>
      </view>
      <view wx:if="{{statement.insightSource === 'loading'}}" class="stmt-insight-body stmt-insight-loading">
        <view class="stmt-insight-spinner"></view>
        <text>账本君正在翻账本…</text>
      </view>
      <view wx:else class="stmt-insight-body">{{statement.insightText}}</view>

      <!-- 对话入口：通栏输入条暗示，点开即进入问答 -->
      <view wx:if="{{!chatOpen && (statement.insightSource === 'cache' || statement.insightSource === 'llm' || statement.insightSource === 'template')}}" class="stmt-ask-bar" bindtap="openChat">
        <text class="ask-text">问问账本君：这个月餐饮花在哪了？</text>
        <view class="ask-arrow">›</view>
      </view>

      <!-- 对话问答区 -->
      <view wx:if="{{chatOpen}}" class="stmt-chat" scroll-y="{{true}}">
        <view class="stmt-chat-head">
          <text>问问账本君</text>
          <view class="stmt-chat-close" bindtap="closeChat">收起</view>
        </view>
        <scroll-view class="stmt-chat-history" scroll-y="{{true}}" scroll-into-view="{{chatScrollIntoView}}" scroll-with-animation="{{true}}">
          <block wx:for="{{chatMessages}}" wx:key="ts" wx:for-item="m">
            <view id="msg-{{m.ts}}" class="stmt-chat-msg {{m.role === 'user' ? 'mine' : 'his'}}">
              <view wx:if="{{m.role === 'assistant'}}" class="chat-avatar"><image class="chat-avatar-img" src="/static/avatar/avatar-c-200.png" mode="aspectFill" /></view>
              <view class="stmt-chat-bubble-wrap">
                <text class="stmt-chat-bubble">{{m.content}}</text>
                <!-- 账本君记账成功 → 5s 倒计时撤销窗口(气泡显示金额/分类/剩余秒数) -->
                <view wx:if="{{m.undoable && !m.undone}}" class="stmt-chat-undo"
                      bindtap="onUndoAiRecord" data-msg-ts="{{m.ts}}" hover-class="stmt-chat-undo-hover">
                  <text wx:if="{{m.toolResult.type === 'salary'}}">{{m.toolResult.salary.label || '收入'}} ¥{{m.toolResult.salary.amount}} · {{m.undoCountdown}}s 内撤销</text>
                  <text wx:elif="{{m.toolResult.expense}}">{{m.toolResult.expense.category}} ¥{{m.toolResult.expense.amount}} · {{m.undoCountdown}}s 内撤销</text>
                </view>
              </view>
            </view>
          </block>
          <view wx:if="{{chatSending}}" id="msg-sending" class="stmt-chat-msg his loading">
            <view class="chat-avatar"><image class="chat-avatar-img" src="/static/avatar/avatar-c-200.png" mode="aspectFill" /></view>
            <view class="stmt-insight-spinner"></view>
            <text>账本君在想…</text>
          </view>
          <!-- 哨兵节点:scroll-into-view 指向这里保证永远滚到最底 -->
          <view id="chat-bottom" style="height: 1rpx;"></view>
        </scroll-view>
        <!-- 快捷问题 chip:输入框上方,点一下即发 -->
        <view class="stmt-quick-chip-row">
          <block wx:for="{{quickChips}}" wx:key="*this">
            <view class="stmt-quick-chip" bindtap="onQuickChipTap" data-text="{{item}}" hover-class="stmt-quick-chip-hover">{{item}}</view>
          </block>
        </view>

        <view class="stmt-chat-input-row">
          <input
            class="stmt-chat-input"
            value="{{chatInput}}"
            maxlength="60"
            placeholder="比如:这个月餐饮花在哪了?"
            bindinput="onChatInput"
            bindfocus="onChatFocus"
            bindconfirm="sendChat"
            confirm-type="send"
            adjust-position="{{true}}"
            cursor-spacing="20"
            hold-keyboard="{{true}}"
          />
          <view class="stmt-chat-send {{chatSending || !chatInput.trim() ? 'disabled' : ''}}" bindtap="sendChat">发送</view>
        </view>
        <view wx:if="{{chatRateError}}" class="stmt-chat-error">{{chatRateError}}</view>
      </view>
    </view>

    <!-- 哨兵节点:scroll-into-view 指向这里保证 sheet 滚到底(看到输入框) -->
    <view id="stmt-bottom" style="height: 1rpx;"></view>

    </scroll-view>

    <view class="sheet-actions statement-bottom">
      <view class="btn btn-primary" bindtap="closeStatement">收下</view>
    </view>
  </view>

  <!-- 分类预算设置 sheet（在账单 sheet 内点 +预算 / 预算金额 弹出） -->
  <view wx:if="{{showCatBudget}}" class="mask {{showCatBudgetClosing ? 'mask-out' : ''}}" bindtap="closeCatBudget"></view>
  <view wx:if="{{showCatBudget}}" class="sheet cat-budget-sheet {{showCatBudgetClosing ? 'sheet-out' : ''}}">
    <view class="sheet-title">「{{catBudgetEditing.name}}」月度预算</view>
    <view class="cat-budget-hint">
      本月已花 ¥{{catBudgetEditing.spentText}}<text wx:if="{{catBudgetEditing.budget > 0}}"> · 剩 ¥{{catBudgetEditing.remainingText}}</text>
    </view>
    <view class="form-item">
      <text class="form-label">预算金额（元）</text>
      <input class="form-input amount-input" type="digit" placeholder="如 1500" value="{{catBudgetInput}}" bindinput="onCatBudgetInput" focus="{{catBudgetFocus}}" adjust-position="{{true}}" cursor-spacing="20" hold-keyboard="{{true}}" />
    </view>
    <view class="sheet-actions">
      <view wx:if="{{catBudgetEditing.budget > 0}}" class="btn btn-secondary cat-budget-clear-btn" bindtap="clearCatBudget">清除预算</view>
      <view class="btn btn-primary" bindtap="saveCatBudget">保存</view>
    </view>
  </view>


</view>
