/* 薪账本 全局样式 — 浅色:轻盈纸感(暖纸底/墨色文字/柔金点缀) · 深色:深蓝夜色 */
page {
  --navy-900: #0A1828;
  --navy-800: #0E2238;
  --navy-700: #14304F;
  --navy-600: #1F4E79;
  --navy-300: #4A6B8A;
  --gold: #C8A04D;
  --gold-light: #F7EDD8;
  --gold-700: #A3823A;
  --text: #2B2620;
  --text-sub: #82766A;
  --text-mute: #ADA294;
  --bg: #F6F2EA;
  --card: #FFFEF9;
  --border: #E7E0D1;
  --border-light: #F0EBE0;
  --danger: #BE4A3A;
  --danger-bg: #FAEFE9;
  --warn: #C98A2D;
  --warn-bg: #FBF3E1;
  --success: #2F9B6B;
  --success-bg: #EDF4E9;
  /* 中性暖灰:进度条未填充轨道 / chip 底 / 按下态 / 输入框底 */
  --fill-bg: #EFE8DB;
  --chip-bg: #F5F0E6;
  --press-bg: #EDE6D8;
  --input-bg: #F9F5EC;
  /* 浅色边框:用于 budget-alert 等警示色块的边框(深色模式自动加深) */
  --danger-border: #F2D2C8;
  --warn-border: #F5E0B8;
  /* 阴影变量:纸感用暖棕投影,深色模式纯黑 */
  --shadow-card: rgba(140, 116, 74, 0.06);
  --shadow-strong: rgba(140, 116, 74, 0.20);
  --shadow-deep: rgba(140, 116, 74, 0.32);
  /* 墨色透明色:浅色模式墨色叠纸(深色模式白色叠暗,深底上要白提亮) */
  --tint-navy-04: rgba(70, 60, 44, 0.04);
  --tint-navy-06: rgba(70, 60, 44, 0.06);
  --tint-navy-08: rgba(70, 60, 44, 0.08);
  --tint-navy-14: rgba(70, 60, 44, 0.14);
  --tint-navy-18: rgba(70, 60, 44, 0.18);
  /* 金 / 红 / 灰透明色:tag、按钮按下态等场景 */
  --tint-gold-06: rgba(200, 160, 77, 0.06);
  --tint-gold-12: rgba(200, 160, 77, 0.12);
  --tint-gold-16: rgba(200, 160, 77, 0.16);
  --tint-gold-18: rgba(200, 160, 77, 0.18);
  --tint-danger-08: rgba(190, 74, 58, 0.08);
  --tint-danger-22: rgba(190, 74, 58, 0.22);
  --tint-text-sub-12: rgba(173, 162, 148, 0.14);
  --tint-danger-strong: #F3DED5;
  /* 消费日历热力图色阶(5 档:无→深,纸感金色系) */
  --heat-0: #F1EBDF;
  --heat-1: #EADFC0;
  --heat-2: #DCC287;
  --heat-3: #C8A04D;
  --heat-4: #C0563C;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 手动指定浅色（系统为深色时）：在页面根节点子树内重声明浅色变量，
 * 覆盖下方媒体查询写到 page 上的深色值。变量清单须与 page 浅色块保持一致。 */
.theme-force-light {
  --navy-900: #0A1828;
  --navy-800: #0E2238;
  --navy-700: #14304F;
  --navy-600: #1F4E79;
  --navy-300: #4A6B8A;
  --gold: #C8A04D;
  --gold-light: #F7EDD8;
  --gold-700: #A3823A;
  --text: #2B2620;
  --text-sub: #82766A;
  --text-mute: #ADA294;
  --bg: #F6F2EA;
  --card: #FFFEF9;
  --border: #E7E0D1;
  --border-light: #F0EBE0;
  --danger: #BE4A3A;
  --danger-bg: #FAEFE9;
  --warn: #C98A2D;
  --warn-bg: #FBF3E1;
  --success: #2F9B6B;
  --success-bg: #EDF4E9;
  --fill-bg: #EFE8DB;
  --chip-bg: #F5F0E6;
  --press-bg: #EDE6D8;
  --input-bg: #F9F5EC;
  --danger-border: #F2D2C8;
  --warn-border: #F5E0B8;
  --shadow-card: rgba(140, 116, 74, 0.06);
  --shadow-strong: rgba(140, 116, 74, 0.20);
  --shadow-deep: rgba(140, 116, 74, 0.32);
  --tint-navy-04: rgba(70, 60, 44, 0.04);
  --tint-navy-06: rgba(70, 60, 44, 0.06);
  --tint-navy-08: rgba(70, 60, 44, 0.08);
  --tint-navy-14: rgba(70, 60, 44, 0.14);
  --tint-navy-18: rgba(70, 60, 44, 0.18);
  --tint-gold-06: rgba(200, 160, 77, 0.06);
  --tint-gold-12: rgba(200, 160, 77, 0.12);
  --tint-gold-16: rgba(200, 160, 77, 0.16);
  --tint-gold-18: rgba(200, 160, 77, 0.18);
  --tint-danger-08: rgba(190, 74, 58, 0.08);
  --tint-danger-22: rgba(190, 74, 58, 0.22);
  --tint-text-sub-12: rgba(173, 162, 148, 0.14);
  --tint-danger-strong: #F3DED5;
  --heat-0: #F1EBDF;
  --heat-1: #EADFC0;
  --heat-2: #DCC287;
  --heat-3: #C8A04D;
  --heat-4: #C0563C;
}

/* ==================== 深色模式 ====================
 * 跟随系统设置(WX 端 + iOS/Android 系统深色),无需手动开关。
 * 仅覆盖变量;page *.wxss 通过 var() 自动跟随。
 */
@media (prefers-color-scheme: dark) {
  page {
    --navy-900: #1F2D40;
    --navy-800: #283A52;
    --navy-700: #4A6B8A;
    --navy-600: #5C82A8;
    --navy-300: #8AA4C2;
    --gold: #E5C26B;
    --gold-light: #2D2519;
    --gold-700: #B89043;
    --text: #E8EDF3;
    --text-sub: #A8B4C5;
    --text-mute: #6E7B8E;
    --bg: #0E1620;
    --card: #1A2532;
    --border: #2D3A4D;
    --border-light: #1F2A37;
    --danger: #E55858;
    --danger-bg: #2A1A1A;
    --warn: #E0A055;
    --warn-bg: #2A2114;
    --success: #4FB78A;
    --success-bg: #142A1F;
    --fill-bg: #243042;
    --chip-bg: #243042;
    --press-bg: #2A3545;
    --input-bg: #1F2A37;
    /* 深色模式警示边框加深,以便在深色 bg 上可见 */
    --danger-border: #5A2A2A;
    --warn-border: #5A4220;
    /* 深色背景下纯黑阴影更深、更不显眼 */
    --shadow-card: rgba(0, 0, 0, 0.28);
    --shadow-strong: rgba(0, 0, 0, 0.45);
    --shadow-deep: rgba(0, 0, 0, 0.55);
    /* 深色模式下用白透明叠在深底上做层次 */
    --tint-navy-04: rgba(255, 255, 255, 0.04);
    --tint-navy-06: rgba(255, 255, 255, 0.06);
    --tint-navy-08: rgba(255, 255, 255, 0.08);
    --tint-navy-14: rgba(255, 255, 255, 0.14);
    --tint-navy-18: rgba(255, 255, 255, 0.18);
    --tint-gold-06: rgba(229, 194, 107, 0.10);
    --tint-gold-12: rgba(229, 194, 107, 0.16);
    --tint-gold-16: rgba(229, 194, 107, 0.22);
    --tint-gold-18: rgba(229, 194, 107, 0.28);
    --tint-danger-08: rgba(229, 88, 88, 0.14);
    --tint-danger-22: rgba(229, 88, 88, 0.32);
    --tint-text-sub-12: rgba(168, 180, 197, 0.16);
    --tint-danger-strong: #4A2020;
    /* 深色模式热力图色阶 */
    --heat-0: #2A3441;
    --heat-1: #3A4F66;
    --heat-2: #6B89A8;
    --heat-3: #B5CCDF;
    --heat-4: #E55858;
  }
}

/* 手动指定深色（系统为浅色时）：在页面根节点子树内重声明深色变量。
 * 变量清单须与上方媒体查询深色块保持一致。 */
.theme-force-dark {
  --navy-900: #1F2D40;
  --navy-800: #283A52;
  --navy-700: #4A6B8A;
  --navy-600: #5C82A8;
  --navy-300: #8AA4C2;
  --gold: #E5C26B;
  --gold-light: #2D2519;
  --gold-700: #B89043;
  --text: #E8EDF3;
  --text-sub: #A8B4C5;
  --text-mute: #6E7B8E;
  --bg: #0E1620;
  --card: #1A2532;
  --border: #2D3A4D;
  --border-light: #1F2A37;
  --danger: #E55858;
  --danger-bg: #2A1A1A;
  --warn: #E0A055;
  --warn-bg: #2A2114;
  --success: #4FB78A;
  --success-bg: #142A1F;
  --fill-bg: #243042;
  --chip-bg: #243042;
  --press-bg: #2A3545;
  --input-bg: #1F2A37;
  --danger-border: #5A2A2A;
  --warn-border: #5A4220;
  --shadow-card: rgba(0, 0, 0, 0.28);
  --shadow-strong: rgba(0, 0, 0, 0.45);
  --shadow-deep: rgba(0, 0, 0, 0.55);
  --tint-navy-04: rgba(255, 255, 255, 0.04);
  --tint-navy-06: rgba(255, 255, 255, 0.06);
  --tint-navy-08: rgba(255, 255, 255, 0.08);
  --tint-navy-14: rgba(255, 255, 255, 0.14);
  --tint-navy-18: rgba(255, 255, 255, 0.18);
  --tint-gold-06: rgba(229, 194, 107, 0.10);
  --tint-gold-12: rgba(229, 194, 107, 0.16);
  --tint-gold-16: rgba(229, 194, 107, 0.22);
  --tint-gold-18: rgba(229, 194, 107, 0.28);
  --tint-danger-08: rgba(229, 88, 88, 0.14);
  --tint-danger-22: rgba(229, 88, 88, 0.32);
  --tint-text-sub-12: rgba(168, 180, 197, 0.16);
  --tint-danger-strong: #4A2020;
  --heat-0: #2A3441;
  --heat-1: #3A4F66;
  --heat-2: #6B89A8;
  --heat-3: #B5CCDF;
  --heat-4: #E55858;
}

/* 手动主题下根视图自绘背景：
 * page 元素背景仍由媒体查询按系统主题渲染（无法被 class 覆盖），
 * 根视图铺满一屏遮住它，下拉回弹区由 JS setBackgroundColor 兜底。 */
.theme-force-light,
.theme-force-dark {
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 8rpx 28rpx var(--shadow-card);
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 24rpx;
  letter-spacing: 0.02em;
}

/* 按钮 */
.btn {
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.08s ease, opacity 0.08s ease;
}
.btn::after { border: none; }

.btn-primary {
  background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
  color: #fff;
  box-shadow: 0 12rpx 32rpx var(--shadow-strong);
}
.btn-primary:active {
  transform: scale(0.985);
  opacity: 0.94;
}

.btn-ghost {
  background: var(--chip-bg);
  color: var(--navy-700);
}
.btn-ghost:active { background: var(--press-bg); }

.btn-danger {
  background: var(--danger-bg);
  color: var(--danger);
}
.btn-danger:active { background: var(--tint-danger-strong); }

.btn-sm {
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  border-radius: 14rpx;
  display: inline-flex;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.tag-red { background: var(--danger-bg); color: var(--danger); }
.tag-yellow { background: var(--warn-bg); color: var(--warn); }
.tag-green { background: var(--success-bg); color: var(--success); }
.tag-gray { background: var(--chip-bg); color: var(--text-sub); }
.tag-gold { background: var(--gold-light); color: var(--gold-700); }
.tag-navy { background: var(--chip-bg); color: var(--navy-700); }

/* 空态 */
.empty {
  text-align: center;
  color: var(--text-mute);
  font-size: 26rpx;
  padding: 72rpx 0;
}

/* 页面级空态（带图标装饰，样式统一收口于此） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}
.empty-state .empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: var(--tint-navy-04);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: var(--navy-300);
  margin-bottom: 32rpx;
}
.empty-state .empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}
.empty-state .empty-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  text-align: center;
}

/* 遮罩与底面板（进出动画） */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(46, 38, 26, 0.45);
  z-index: 90;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  animation: maskIn 0.22s ease;
}

.mask-out {
  animation: maskOut 0.22s ease forwards;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  z-index: 100;
  max-height: 82vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  /* 顶部投影强化面板悬浮感（底面板无需左右/底部阴影） */
  box-shadow: 0 -12rpx 48rpx var(--shadow-strong);
  animation: sheetIn 0.28s cubic-bezier(0.32, 0.72, 0.34, 1);
  /* 键盘弹出时弹框保持底部定位，不被顶高 */
}

.sheet-out {
  animation: sheetOut 0.24s ease forwards;
}

@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes maskOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes sheetIn {
  from { transform: translateY(100%); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes sheetOut {
  from { transform: translateY(0); opacity: 1; }
  to { transform: translateY(100%); opacity: 0; }
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  text-align: center;
  margin-bottom: 32rpx;
}

/* 表单 */
.form-item {
  margin-bottom: 28rpx;
}
.form-label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}
.form-input {
  background: var(--input-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  min-height: 96rpx;
  box-sizing: border-box;
  width: 100%;
  color: var(--text);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.form-input:focus {
  outline: none;
  border-color: var(--gold);
  box-shadow: 0 0 0 4rpx var(--tint-gold-12);
}

.picker-val {
  display: flex;
  align-items: center;
  color: var(--text);
}

.form-tip {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
  line-height: 1.5;
}

.sheet-actions {
  margin-top: 32rpx;
}

/* 通用辅助 */
.money {
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  font-variant-numeric: tabular-nums;
}

/* 自定义导航栏（tab 页 navigationStyle: custom 共用）
   浅色模式:白底深字; 深色模式:深蓝底白字 —— 跟随主题,不再硬写死 navy-700 */
.navbar {
  background: var(--card);
  padding-top: 44px; /* JS 注入 statusBarHeight 覆盖此默认值 */
  border-bottom: 1rpx solid var(--border-light);
}
.navbar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
}
.navbar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.04em;
}

@media (prefers-color-scheme: dark) {
  .navbar {
    background: var(--navy-800);
    border-bottom-color: transparent;
  }
  .navbar-title {
    color: #fff;
  }
}

/* 手动主题下导航栏跟随生效主题（而非系统主题）：
 * force class 选择器优先级高于上方媒体查询里的 .navbar，可覆盖其深色硬编码 */
.theme-force-dark .navbar {
  background: var(--navy-800);
  border-bottom-color: transparent;
}
.theme-force-dark .navbar-title {
  color: #fff;
}
.theme-force-light .navbar {
  background: var(--card);
  border-bottom-color: var(--border-light);
}
.theme-force-light .navbar-title {
  color: var(--text);
}

/* 全局悬浮「记一笔」快捷入口（仅首页），右下角圆形按钮 */
.quick-add {
  position: fixed;
  right: 32rpx;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--gold), var(--gold-700));
  color: var(--navy-900);
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 6rpx; /* ＋ 视觉居中 */
  box-sizing: border-box;
  box-shadow: 0 12rpx 32rpx var(--shadow-deep);
  z-index: 80;
}
.quick-add:active {
  transform: scale(0.94);
  opacity: 0.92;
}

/* 全局悬浮胶囊按钮（列表页「添加」入口，样式统一收口于此） */
.fab {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 56rpx;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 32rpx var(--shadow-strong);
  z-index: 50;
}
.fab:active {
  transform: translateX(-50%) scale(0.98);
  opacity: 0.94;
}

.text-sub { color: var(--text-sub); }
.text-mute { color: var(--text-mute); }
.text-navy { color: var(--navy-700); }
.text-gold { color: var(--gold); }
.text-danger { color: var(--danger); }

/* ==================== 骨架屏 ==================== */
.sk-wrap {
  padding: 24rpx 0;
}

.sk-card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  border: 1rpx solid var(--border-light);
  box-shadow: 0 8rpx 28rpx var(--shadow-card);
}

.sk-block {
  background: linear-gradient(90deg, #EFE8DC 25%, #F8F3E9 37%, #EFE8DC 63%);
  background-size: 400% 100%;
  animation: skShimmer 1.4s ease infinite;
  border-radius: 12rpx;
  height: 32rpx;
}
.sk-block.round { border-radius: 999rpx; }
.sk-h { height: 44rpx; }
.sk-l { height: 64rpx; }
.sk-xl { height: 96rpx; }
.sk-w20 { width: 20%; }
.sk-w25 { width: 25%; }
.sk-w30 { width: 30%; }
.sk-w40 { width: 40%; }
.sk-w50 { width: 50%; }
.sk-w60 { width: 60%; }
.sk-w70 { width: 70%; }
.sk-w80 { width: 80%; }
.sk-w100 { width: 100%; }

.sk-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.sk-row:last-child { margin-bottom: 0; }
.sk-mt { margin-top: 24rpx; }
.sk-mb { margin-bottom: 24rpx; }

@keyframes skShimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
