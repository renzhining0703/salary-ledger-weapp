/* 薪账本 全局样式 — 深蓝金融质感 */
page {
  --navy-900: #0A1828;
  --navy-800: #0E2238;
  --navy-700: #14304F;
  --navy-600: #1F4E79;
  --navy-300: #4A6B8A;
  --gold: #C8A04D;
  --gold-light: #F4E9D2;
  --gold-700: #A3823A;
  --text: #151E2B;
  --text-sub: #657183;
  --text-mute: #97A3B2;
  --bg: #F3F5F8;
  --card: #FFFFFF;
  --border: #E4E8EE;
  --border-light: #EDF0F4;
  --danger: #C94040;
  --danger-bg: #FBEFEF;
  --warn: #C98A2D;
  --warn-bg: #FEF6E8;
  --success: #2F9B6B;
  --success-bg: #EAF6EF;
  /* 中性灰:进度条未填充轨道 / chip 底 / 按下态 / 输入框底 */
  --fill-bg: #E8EDF3;
  --chip-bg: #F1F5FA;
  --press-bg: #E8EDF3;
  --input-bg: #F7F8FA;
  /* 浅色边框:用于 budget-alert 等警示色块的边框(深色模式自动加深) */
  --danger-border: #F5CFCF;
  --warn-border: #F8E3B5;
  /* 阴影变量:浅色模式海军蓝投影,深色模式纯黑 */
  --shadow-card: rgba(20, 48, 79, 0.05);
  --shadow-strong: rgba(20, 48, 79, 0.22);
  --shadow-deep: rgba(20, 48, 79, 0.35);
  /* 海军蓝透明色:浅色模式海军蓝叠白,深色模式白色叠暗(深底上要白提亮) */
  --tint-navy-04: rgba(20, 48, 79, 0.04);
  --tint-navy-06: rgba(20, 48, 79, 0.06);
  --tint-navy-08: rgba(20, 48, 79, 0.08);
  --tint-navy-14: rgba(20, 48, 79, 0.14);
  --tint-navy-18: rgba(20, 48, 79, 0.18);
  /* 金 / 红 / 灰透明色:tag、按钮按下态等场景 */
  --tint-gold-06: rgba(200, 160, 77, 0.06);
  --tint-gold-12: rgba(200, 160, 77, 0.12);
  --tint-gold-16: rgba(200, 160, 77, 0.16);
  --tint-gold-18: rgba(200, 160, 77, 0.18);
  --tint-danger-08: rgba(201, 64, 64, 0.08);
  --tint-danger-22: rgba(201, 64, 64, 0.22);
  --tint-text-sub-12: rgba(151, 163, 178, 0.12);
  --tint-danger-strong: #F5DFDF;
  /* 消费日历热力图色阶(5 档:无→深) */
  --heat-0: #EDF0F4;
  --heat-1: #DDE6F0;
  --heat-2: #9FB6D1;
  --heat-3: #4A6B8A;
  --heat-4: #C94040;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== 深色模式 ====================
 * 跟随系统设置(WX 端 + iOS/Android 系统深色),无需手动开关。
 * 仅覆盖变量;page *.wxss 通过 var() 自动跟随。
 */
@media (prefers-color-scheme: dark) {
  page {
    --navy-900: #1F2D40;
    --navy-800: #283A52;
    --navy-700: #4A6B8A;
    --navy-600: #5C82A8;
    --navy-300: #8AA4C2;
    --gold: #E5C26B;
    --gold-light: #2D2519;
    --gold-700: #B89043;
    --text: #E8EDF3;
    --text-sub: #A8B4C5;
    --text-mute: #6E7B8E;
    --bg: #0E1620;
    --card: #1A2532;
    --border: #2D3A4D;
    --border-light: #1F2A37;
    --danger: #E55858;
    --danger-bg: #2A1A1A;
    --warn: #E0A055;
    --warn-bg: #2A2114;
    --success: #4FB78A;
    --success-bg: #142A1F;
    --fill-bg: #243042;
    --chip-bg: #243042;
    --press-bg: #2A3545;
    --input-bg: #1F2A37;
    /* 深色模式警示边框加深,以便在深色 bg 上可见 */
    --danger-border: #5A2A2A;
    --warn-border: #5A4220;
    /* 深色背景下纯黑阴影更深、更不显眼 */
    --shadow-card: rgba(0, 0, 0, 0.28);
    --shadow-strong: rgba(0, 0, 0, 0.45);
    --shadow-deep: rgba(0, 0, 0, 0.55);
    /* 深色模式下用白透明叠在深底上做层次 */
    --tint-navy-04: rgba(255, 255, 255, 0.04);
    --tint-navy-06: rgba(255, 255, 255, 0.06);
    --tint-navy-08: rgba(255, 255, 255, 0.08);
    --tint-navy-14: rgba(255, 255, 255, 0.14);
    --tint-navy-18: rgba(255, 255, 255, 0.18);
    --tint-gold-06: rgba(229, 194, 107, 0.10);
    --tint-gold-12: rgba(229, 194, 107, 0.16);
    --tint-gold-16: rgba(229, 194, 107, 0.22);
    --tint-gold-18: rgba(229, 194, 107, 0.28);
    --tint-danger-08: rgba(229, 88, 88, 0.14);
    --tint-danger-22: rgba(229, 88, 88, 0.32);
    --tint-text-sub-12: rgba(168, 180, 197, 0.16);
    --tint-danger-strong: #4A2020;
    /* 深色模式热力图色阶 */
    --heat-0: #2A3441;
    --heat-1: #3A4F66;
    --heat-2: #6B89A8;
    --heat-3: #B5CCDF;
    --heat-4: #E55858;
  }
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 8rpx 28rpx var(--shadow-card);
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 24rpx;
  letter-spacing: 0.02em;
}

/* 按钮 */
.btn {
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.08s ease, opacity 0.08s ease;
}
.btn::after { border: none; }

.btn-primary {
  background: linear-gradient(135deg, var(--navy-700), var(--navy-800));
  color: #fff;
  box-shadow: 0 12rpx 32rpx var(--shadow-strong);
}
.btn-primary:active {
  transform: scale(0.985);
  opacity: 0.94;
}

.btn-ghost {
  background: var(--chip-bg);
  color: var(--navy-700);
}
.btn-ghost:active { background: var(--press-bg); }

.btn-danger {
  background: var(--danger-bg);
  color: var(--danger);
}
.btn-danger:active { background: var(--tint-danger-strong); }

.btn-sm {
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  border-radius: 14rpx;
  display: inline-flex;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
}
.tag-red { background: var(--danger-bg); color: var(--danger); }
.tag-yellow { background: var(--warn-bg); color: var(--warn); }
.tag-green { background: var(--success-bg); color: var(--success); }
.tag-gray { background: var(--chip-bg); color: var(--text-sub); }
.tag-gold { background: var(--gold-light); color: var(--gold-700); }
.tag-navy { background: var(--chip-bg); color: var(--navy-700); }

/* 空态 */
.empty {
  text-align: center;
  color: var(--text-mute);
  font-size: 26rpx;
  padding: 72rpx 0;
}

/* 遮罩与底面板（进出动画） */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(10, 24, 40, 0.55);
  z-index: 90;
  backdrop-filter: blur(2rpx);
  animation: maskIn 0.22s ease;
}

.mask-out {
  animation: maskOut 0.22s ease forwards;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  z-index: 100;
  max-height: 82vh;
  overflow-y: auto;
  animation: sheetIn 0.28s cubic-bezier(0.32, 0.72, 0.34, 1);
  /* 键盘弹出时弹框保持底部定位，不被顶高 */
}

.sheet-out {
  animation: sheetOut 0.24s ease forwards;
}

@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes maskOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes sheetIn {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes sheetOut {
  from { transform: translateY(0); opacity: 1; }
  to { transform: translateY(100%); opacity: 0; }
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  text-align: center;
  margin-bottom: 32rpx;
}

/* 表单 */
.form-item {
  margin-bottom: 28rpx;
}
.form-label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}
.form-input {
  background: var(--input-bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  min-height: 96rpx;
  box-sizing: border-box;
  width: 100%;
  color: var(--text);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.form-input:focus {
  outline: none;
  border-color: var(--gold);
  box-shadow: 0 0 0 4rpx var(--tint-gold-12);
}

.picker-val {
  display: flex;
  align-items: center;
  color: var(--text);
}

.form-tip {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
  line-height: 1.5;
}

.sheet-actions {
  margin-top: 32rpx;
}

/* 通用辅助 */
.money {
  font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif;
  font-variant-numeric: tabular-nums;
}

/* 全局悬浮「记一笔」快捷入口（仅首页），主题深蓝 */
.quick-add {
  position: fixed;
  right: 32rpx;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--navy-700), var(--navy-900));
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 6rpx; /* ＋ 视觉居中 */
  box-sizing: border-box;
  box-shadow: 0 12rpx 32rpx var(--shadow-deep);
  /* 必须低于 .mask(90) 和 .sheet(100),但要高于 trend canvas(1) 防止被柱状图盖住 */
  z-index: 80;
}
.quick-add:active {
  transform: scale(0.94);
  opacity: 0.92;
}

.text-sub { color: var(--text-sub); }
.text-mute { color: var(--text-mute); }
.text-navy { color: var(--navy-700); }
.text-gold { color: var(--gold); }
.text-danger { color: var(--danger); }

/* ==================== 骨架屏 ==================== */
.sk-wrap {
  padding: 24rpx;
}

.sk-card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-light);
  box-shadow: 0 8rpx 28rpx var(--shadow-card);
}

.sk-block {
  background: linear-gradient(90deg, #E9EDF2 25%, #F4F7FA 37%, #E9EDF2 63%);
  background-size: 400% 100%;
  animation: skShimmer 1.4s ease infinite;
  border-radius: 12rpx;
  height: 32rpx;
}
.sk-block.round { border-radius: 999rpx; }
.sk-h { height: 44rpx; }
.sk-l { height: 64rpx; }
.sk-xl { height: 96rpx; }
.sk-w20 { width: 20%; }
.sk-w25 { width: 25%; }
.sk-w30 { width: 30%; }
.sk-w40 { width: 40%; }
.sk-w50 { width: 50%; }
.sk-w60 { width: 60%; }
.sk-w70 { width: 70%; }
.sk-w80 { width: 80%; }
.sk-w100 { width: 100%; }

.sk-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.sk-row:last-child { margin-bottom: 0; }
.sk-mt { margin-top: 24rpx; }
.sk-mb { margin-bottom: 24rpx; }

@keyframes skShimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
