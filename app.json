{
  "pages": [
    "pages/index/index",
    "pages/salary/salary",
    "pages/cards/cards",
    "pages/expenses/expenses",
    "pages/statement/statement",
    "pages/calendar/calendar",
    "pages/subscriptions/subscriptions",
    "pages/my/my",
    "pages/recycle/recycle",
    "pages/lock/lock"
  ],
  "window": {
    "navigationBarBackgroundColor": "@navBg",
    "navigationBarTitleText": "薪账本",
    "navigationBarTextStyle": "@navTxt",
    "backgroundColor": "@pageBg",
    "backgroundTextStyle": "@bgTxt"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelected",
    "backgroundColor": "@tabBg",
    "borderStyle": "@tabBorder",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "images/tab-home.png",
        "selectedIconPath": "images/tab-home-active.png"
      },
      {
        "pagePath": "pages/salary/salary",
        "text": "收入",
        "iconPath": "images/tab-salary.png",
        "selectedIconPath": "images/tab-salary-active.png"
      },
      {
        "pagePath": "pages/expenses/expenses",
        "text": "记账",
        "iconPath": "images/tab-expense.png",
        "selectedIconPath": "images/tab-expense-active.png"
      },
      {
        "pagePath": "pages/my/my",
        "text": "我的",
        "iconPath": "images/tab-my.png",
        "selectedIconPath": "images/tab-my-active.png"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "darkmode": true,
  "themeLocation": "theme.json"
}
