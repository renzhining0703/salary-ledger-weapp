/* 分类图标网格选择器（设计稿：4 列网格 · emoji 图标 · 选中金色高亮）
 * 颜色全部走 CSS 变量，浅色/深色主题自动跟随（变量由页面根节点继承进来）。 */

:host {
  display: block;
}

.cg-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.cg-cell {
  /* 4 列：宽度 = (100% - 3 × gap) / 4，用 flex 规避低版本 webview 的 grid 兼容问题 */
  width: calc((100% - 60rpx) / 4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 20rpx;
  border-radius: 28rpx;
  background: var(--input-bg);
  border: 3rpx solid transparent;
  box-sizing: border-box;
  position: relative;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
}

.cg-cell-hover {
  transform: scale(0.96);
}

/* 图标容器：80×80rpx 圆角底，tone 决定底色（半透明色叠 input-bg） */
.cg-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  transition: background 0.15s ease, box-shadow 0.15s ease;
}

.tone-gold { background: var(--tint-gold-12); }
.tone-navy { background: var(--tint-navy-14); }
.tone-danger { background: var(--tint-danger-08); }
.tone-success { background: var(--tint-success-12); }
.tone-warn { background: var(--tint-warn-12); }
.tone-text { background: var(--tint-text-sub-12); }

.cg-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-sub);
  transition: color 0.15s ease;
  white-space: nowrap;
}

/* ---------- 选中态：金色边框 + 金底图标 + 勾标 ---------- */
.cg-cell.cg-selected {
  background: var(--tint-gold-06);
  border-color: var(--gold);
  box-shadow: 0 4rpx 20rpx var(--tint-gold-12);
}

/* 选择器优先级高于 tone-*（3 类名 > 2 类名），无需 !important */
.cg-cell.cg-selected .cg-icon {
  background: linear-gradient(135deg, var(--gold), var(--gold-700));
  box-shadow: 0 4rpx 16rpx var(--tint-gold-18);
}

.cg-cell.cg-selected .cg-label {
  color: var(--gold-700);
  font-weight: 700;
}

/* 右上角金色勾标圆点 */
.cg-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--gold);
  color: var(--navy-900);
  font-size: 18rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--card);
  box-sizing: border-box;
}
